rely."},"47":{"id":"/en/docs/getting-started/installation-8","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#vanilla-applications","content":"Use the shared entry when state crosses a Worker, SharedWorker, or injected transport boundary:"},"48":{"id":"/en/docs/getting-started/installation-9","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"Install the core plus one framework binding:"},"49":{"id":"/en/docs/getting-started/installation-10","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"Framework"},"50":{"id":"/en/docs/getting-started/installation-11","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"Package"},"51":{"id":"/en/docs/getting-started/installation-12","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"Primary reactive API"},"52":{"id":"/en/docs/getting-started/installation-13","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"React 18–19"},"53":{"id":"/en/docs/getting-started/installation-14","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"`@coaction/react`"},"54":{"id":"/en/docs/getting-started/installation-15","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"`create()`, `observer()`, `<Observer>`"},"55":{"id":"/en/docs/getting-started/installation-16","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"Vue"},"56":{"id":"/en/docs/getting-started/installation-17","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"`@coaction/vue`"},"57":{"id":"/en/docs/getting-started/installation-18","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"callable store and computed selectors"},"58":{"id":"/en/docs/getting-started/installation-19","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"Angular"},"59":{"id":"/en/docs/getting-started/installation-20","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"`@coaction/ng`"},"60":{"id":"/en/docs/getting-started/installation-21","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"`store.select()` signal"},"61":{"id":"/en/docs/getting-started/installation-22","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"Svelte"},"62":{"id":"/en/docs/getting-started/installation-23","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"`@coaction/svelte`"},"63":{"id":"/en/docs/getting-started/installation-24","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"readable selector store"},"64":{"id":"/en/docs/getting-started/installation-25","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"Solid"},"65":{"id":"/en/docs/getting-started/installation-26","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"`@coaction/solid`"},"66":{"id":"/en/docs/getting-started/installation-27","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"selector accessor"},"67":{"id":"/en/docs/getting-started/installation-28","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"See framework integrations for runnable examples."},"68":{"id":"/en/docs/getting-started/installation-29","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#optional-integrations","content":"Install only the integration that owns or decorates your state:"},"69":{"id":"/en/docs/getting-started/installation-30","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#optional-integrations","content":"External-state adapters are whole-store bridges. Do not place a Zustand, MobX, Pinia, Jotai,\nRedux, Valtio, or XState adapter under a native Coaction slice key."},"70":{"id":"/en/docs/getting-started/installation-31","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#entry-point-map","content":"Import"},"71":{"id":"/en/docs/getting-started/installation-32","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#entry-point-map","content":"Intended audience"},"72":{"id":"/en/docs/getting-started/installation-33","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#entry-point-map","content":"`coaction`"},"73":{"id":"/en/docs/getting-started/installation-34","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#entry-point-map","content":"Local vanilla stores and signal primitives"},"74":{"id":"/en/docs/getting-started/installation-35","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#entry-point-map","content":"`coaction/shared`"},"75":{"id":"/en/docs/getting-started/installation-36","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#entry-point-map","content":"Local stores, shared authorities, and client mirrors"},"76":{"id":"/en/docs/getting-started/installation-37","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#entry-point-map","content":"`coaction/adapter`"},"77":{"id":"/en/docs/getting-started/installation-38","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#entry-point-map","content":"Authors of external-store adapters and low-level middleware"},"78":{"id":"/en/docs/getting-started/installation-39","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#entry-point-map","content":"Do not deploy a new shared client against an authority running a different\nCoaction major. Upgrade the Worker/SharedWorker authority and all clients as\none deployment unit."},"79":{"id":"/en/docs/getting-started/installation-40","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#entry-point-map","content":"Next, create a store."},"80":{"id":"/en/docs/getting-started/quick-start","page_id":"/en/docs/getting-started/quick-start","type":"page","content":"Quick start","breadcrumbs":["Coaction","Getting started"],"tags":[],"url":"/en/docs/getting-started/quick-start"},"81":{"id":"/en/docs/getting-started/quick-start-0","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start","content":"Create a React store with immutable updates, cached derived state, and precise render tracking."},"82":{"id":"/en/docs/getting-started/quick-start-1","page_id":"/en/docs/getting-started/quick-start","type":"heading","tags":[],"url":"/en/docs/getting-started/quick-start#1-create-the-store","content":"1\\. Create the store"},"83":{"id":"/en/docs/getting-started/quick-start-2","page_id":"/en/docs/getting-started/quick-start","type":"heading","tags":[],"url":"/en/docs/getting-started/quick-start#2-render-it-precisely","content":"2\\. Render it precisely"},"84":{"id":"/en/docs/getting-started/quick-start-3","page_id":"/en/docs/getting-started/quick-start","type":"heading","tags":[],"url":"/en/docs/getting-started/quick-start#3-use-explicit-selectors-when-they-are-clearer","content":"3\\. Use explicit selectors when they are clearer"},"85":{"id":"/en/docs/getting-started/quick-start-4","page_id":"/en/docs/getting-started/quick-start","type":"heading","tags":[],"url":"/en/docs/getting-started/quick-start#4-use-the-imperative-store-api-outside-react","content":"4\\. Use the imperative store API outside React"},"86":{"id":"/en/docs/getting-started/quick-start-5","page_id":"/en/docs/getting-started/quick-start","type":"heading","tags":[],"url":"/en/docs/getting-started/quick-start#next-steps","content":"Next steps"},"87":{"id":"/en/docs/getting-started/quick-start-6","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start","content":"This example uses React because it shows state creation and render tracking in one place. The\nunderlying store model is the same in every framework."},"88":{"id":"/en/docs/getting-started/quick-start-7","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#1-create-the-store","content":"The accessor getter is cached. Coaction records which state fields it reads and recomputes it\nonly after one of those dependencies changes."},"89":{"id":"/en/docs/getting-started/quick-start-8","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#1-create-the-store","content":"`set()` opens an immutable update boundary. Code inside the callback edits a Mutative draft;\nsubscribers receive the committed next state."},"90":{"id":"/en/docs/getting-started/quick-start-9","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#2-render-it-precisely","content":"Inside `observer()`, `useCounter()` tracks the fields read during render. The component above\ndepends on `count`, `doubled`, and the `increment` method; unrelated store fields do not cause it\nto render again."},"91":{"id":"/en/docs/getting-started/quick-start-10","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#2-render-it-precisely","content":"Without `observer()`, calling `useCounter()` subscribes to the whole store. That behavior is\nuseful when the store is small or a component intentionally observes everything."},"92":{"id":"/en/docs/getting-started/quick-start-11","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#3-use-explicit-selectors-when-they-are-clearer","content":"Automatic tracking is optional:"},"93":{"id":"/en/docs/getting-started/quick-start-12","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#3-use-explicit-selectors-when-they-are-clearer","content":"The selector runs inside a reactive tracker, so the paths it reads become its dependencies: a\nwrite that touches none of them does not re-run it at all. `Object.is` still decides the\nre-render, but most writes never reach the comparison. For frequently reused field selectors,\ncreate a cached selector map once:"},"94":{"id":"/en/docs/getting-started/quick-start-13","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#4-use-the-imperative-store-api-outside-react","content":"Framework stores retain the core store contract:"},"95":{"id":"/en/docs/getting-started/quick-start-14","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#4-use-the-imperative-store-api-outside-react","content":"`getState()` includes data, methods, and getters. `getPureState()` returns only the data view and\nis the better choice for logging, serialization, and tests."},"96":{"id":"/en/docs/getting-started/quick-start-15","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#next-steps","content":"<Card title=\"State and actions\" href=\"/en/docs/concepts/state-and-actions\" description=\"Understand writes, schema, subscriptions, and lifecycle.\" />"},"97":{"id":"/en/docs/getting-started/quick-start-16","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#next-steps","content":"<Card title=\"Computed state\" href=\"/en/docs/concepts/computed\" description=\"Choose between accessor getters and explicit dependencies.\" />"},"98":{"id":"/en/docs/getting-started/quick-start-17","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#next-steps","content":"<Card title=\"Slices\" href=\"/en/docs/concepts/slices\" description=\"Organize a larger native store into namespaces.\" />"},"99":{"id":"/en/docs/getting-started/quick-start-18","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#next-steps","content":"<Card title=\"Shared runtime\" href=\"/en/docs/shared/overview\" description=\"Move method execution into a worker authority.\" />"},"100":{"id":"/en/docs/concepts/computed","page_id":"/en/docs/concepts/computed","type":"page","content":"Computed state","breadcrumbs":["Coaction","Core concepts"],"tags":[],"url":"/en/docs/concepts/computed"},"101":{"id":"/en/docs/concepts/computed-0","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed","content":"Choose frozen getter snapshots, explicit paths, or managed deep selectors."},"102":{"id":"/en/docs/concepts/computed-1","page_id":"/en/docs/concepts/computed","type":"heading","tags":[],"url":"/en/docs/concepts/computed#accessor-getters","content":"Accessor getters"},"103":{"id":"/en/docs/concepts/computed-2","page_id":"/en/docs/concepts/computed","type":"heading","tags":[],"url":"/en/docs/concepts/computed#explicit-dependencies-with-get","content":"Explicit dependencies with `get()`"},"104":{"id":"/en/docs/concepts/computed-3","page_id":"/en/docs/concepts/computed","type":"heading","tags":[],"url":"/en/docs/concepts/computed#tracking-granularity","content":"Tracking granularity"},"105":{"id":"/en/docs/concepts/computed-4","page_id":"/en/docs/concepts/computed","type":"heading","tags":[],"url":"/en/docs/concepts/computed#managed-derived-reads","content":"Managed derived reads"},"106":{"id":"/en/docs/concepts/computed-5","page_id":"/en/docs/concepts/computed","type":"heading","tags":[],"url":"/en/docs/concepts/computed#object-identity-is-a-separate-dependency","content":"Object identity is a separate dependency"},"107":{"id":"/en/docs/concepts/computed-6","page_id":"/en/docs/concepts/computed","type":"heading","tags":[],"url":"/en/docs/concepts/computed#result-equality","content":"Result equality"},"108":{"id":"/en/docs/concepts/computed-7","page_id":"/en/docs/concepts/computed","type":"heading","tags":[],"url":"/en/docs/concepts/computed#transactions-ownership-and-react","content":"Transactions, ownership and React"},"109":{"id":"/en/docs/concepts/computed-8","page_id":"/en/docs/concepts/computed","type":"heading","tags":[],"url":"/en/docs/concepts/computed#standalone-signal-primitives","content":"Standalone signal primitives"},"110":{"id":"/en/docs/concepts/computed-9","page_id":"/en/docs/concepts/computed","type":"heading","tags":[],"url":"/en/docs/concepts/computed#external-adapters","content":"External adapters"},"111":{"id":"/en/docs/concepts/computed-10","page_id":"/en/docs/concepts/computed","type":"heading","tags":[],"url":"/en/docs/concepts/computed#performance-expectations","content":"Performance expectations"},"112":{"id":"/en/docs/concepts/computed-11","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed","content":"Coaction's computed values use the same signal graph as field tracking. A component can read a\ncached getter, that getter can read store fields, and invalidation flows through the graph without\nmanual memo arrays."},"113":{"id":"/en/docs/concepts/computed-12","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#accessor-getters","content":"Use a normal getter for the default derived-state experience:"},"114":{"id":"/en/docs/concepts/computed-13","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#accessor-getters","content":"`subtotal` is cached until `items` changes. `total` depends on the cached `subtotal` and\n`taxRate`; those relationships are discovered automatically."},"115":{"id":"/en/docs/concepts/computed-14","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#accessor-getters","content":"Keep getters pure. A getter should not call `setState()`, mutate external state, or produce a\ndifferent result from hidden side effects."},"116":{"id":"/en/docs/concepts/computed-15","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#explicit-dependencies-with-get","content":"The second argument passed to a store factory can declare dependencies manually:"},"117":{"id":"/en/docs/concepts/computed-16","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#explicit-dependencies-with-get","content":"Use this form when dependency declaration makes cross-slice logic clearer, or when integration\ncode should not rely on implicit getter reads."},"118":{"id":"/en/docs/concepts/computed-17","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#explicit-dependencies-with-get","content":"Calling `get()` without arguments returns the current root state. In a slice factory this is a\nconvenient way to read another namespace, though update logic should still happen through\n`set()`."},"119":{"id":"/en/docs/concepts/computed-18","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#tracking-granularity","content":"Native getters and `get(deps, fn)` read frozen snapshots at the store/slice field boundary.\nReading `this.user.name` in a getter therefore invalidates that getter when `user.age` changes.\nWith `get(s => [s.user.name], fn)`, the dependency selector runs again, but `fn` can reuse its\nresult when the selected name is unchanged. Recomputing a getter and notifying its consumers\nare separate: an unchanged primitive result can suppress downstream work."},"120":{"id":"/en/docs/concepts/computed-19","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#tracking-granularity","content":"React selectors and `observer` use managed deep path tracking. A selector reading\n`state.user.name` can ignore an age-only recipe update. Parent replacement, array structure,\nand graph snapshot patches can invalidate more broadly. Array elements are read as values: a\nreader of `state.todos[0].title` depends on `todos[0]` itself, so an `observer` re-renders after\nany write inside that element, while a selector reruns but re-renders only when its result\nchanges."},"121":{"id":"/en/docs/concepts/computed-20","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#managed-derived-reads","content":"The optional `coaction/derived` entry adds store-owned cached reads without changing native\ngetter defaults or adding this runtime to the default entry's consumer bundle:"},"122":{"id":"/en/docs/concepts/computed-21","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#managed-derived-reads","content":"`derivePath` copies the path when created, supports string/number/symbol keys, and returns\n`undefined` for missing data. It selects data, not methods or native computed getters. Use\n`derive` to compose getters or to select a path dynamically. There is no incremental `reduce`,\n`filter`, or `sort` algorithm hidden behind either API."},"123":{"id":"/en/docs/concepts/computed-22","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#object-identity-is-a-separate-dependency","content":"`derive(store, selector)` conservatively retains traversed object identities by default.\n`{ deep: true }` opts into value selection: traversing an object to reach a child does not\nautomatically retain the parent's identity. JavaScript `===`, `Object.is`, and WeakMap lookups\ncannot be detected by property traps. Mark these uses explicitly:"},"124":{"id":"/en/docs/concepts/computed-23","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#object-identity-is-a-separate-dependency","content":"An age change must rerun this selector because it replaces the `user` object, even though the\nname is unchanged. `identity()` returns the same readonly object; `whole()` instead returns\nowned raw data for coarse scans, which must never be mutated."},"125":{"id":"/en/docs/concepts/computed-24","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#object-identity-is-a-separate-dependency","content":"Array elements are values rather than readonly proxies. An element read by index, found by a\nscan or returned by a getter is the frozen element itself, so it compares equal however it was\nreached, and an object also held at an object key has one identity across both. Reading an\nelement depends on its identity: any write inside an element gives it a new identity, while\nwrites to its siblings do not. A write to an element outside `set()` throws a\n`TypeError` in strict-mode code and is silently ignored in sloppy-mode scripts; either way the\nstate is unchanged."},"126":{"id":"/en/docs/concepts/computed-25","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#object-identity-is-a-separate-dependency","content":"Array methods that read every element without changing it, such as `filter`, `map`, `find`,\n`reduce`, `slice` and `for...of`, take one dependency on the array and run over the array itself.\nReads of other state inside the callback are tracked as usual. Use `whole()` for traversals that\nare not a single array method, such as an indexed loop or the values of a record."},"127":{"id":"/en/docs/concepts/computed-26","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#object-identity-is-a-separate-dependency","content":"Returning a state object directly, or carrying it inside ordinary object/array data wrappers,\nretains its terminal dependency automatically. Cyclic wrappers are supported. Output accessors\nare not invoked, and opaque instances, functions and closures are not traversed: mark any state\nobjects captured there with `identity()` during selection. Arrays, holes, symbols, null\nprototypes, cycles and shared references retain the local-state contract. Date, Map, Set and\nclass instances remain atomic identity leaves; their internal mutations are not made reactive."},"128":{"id":"/en/docs/concepts/computed-27","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#result-equality","content":"Result comparison defaults to `Object.is`, including its NaN and signed-zero behavior. A fresh\nobject result is different even when its fields are equal. Supply `equals` to reuse equivalent\nderived data:"},"129":{"id":"/en/docs/concepts/computed-28","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#result-equality","content":"Comparison is independent of dependency selection and runs without collecting dependencies.\nEven when a result is reused, branch dependencies are reconciled. The comparator must be pure.\nChanges to state objects carried in the output still propagate, including live root/slice\nfacades: result equality does not hide a change to their state. Structural equality of arbitrary\nlocal graphs is not the default."},"130":{"id":"/en/docs/concepts/computed-29","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#transactions-ownership-and-react","content":"Reads inside a recipe evaluate against that store's current draft without installing a cache\nor retaining draft proxies. Failed recipes and validator vetoes leave the committed cache intact;\nconsumers are invalidated after an accepted commit. Selector failures remain failures on cached\nreads and retry when a dependency changes. Compose derivations owned by the same store; this API\ndoes not coordinate transactions between different stores. Selectors must be synchronous pure\nreads. Work after `await` is outside dependency collection; this is not a Resource/Suspense API."},"131":{"id":"/en/docs/concepts/computed-30","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#transactions-ownership-and-react","content":"Each read keeps its current dependencies until `dispose()` or `store.destroy()`. Unread\nderivations do not activate patches. Disposing is idempotent, releases the read's dependencies\nand cache, and makes subsequent calls throw. Stopping a consumer does not dispose a store-owned\nderivation: it stays available for other consumers. Native getter caches have their own existing\nstore lifetime."},"132":{"id":"/en/docs/concepts/computed-31","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#transactions-ownership-and-react","content":"Create derivations with their store or another explicit owner, outside React render. Creating\none in a render or relying on `useMemo` as a cleanup boundary can retain abandoned instances.\nAn existing store-owned read works in a selector or an observer:"},"133":{"id":"/en/docs/concepts/computed-32","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#transactions-ownership-and-react","content":"Here `usePerson` is a store from `@coaction/react`. Dispose `displayName` when its owner ends,\nor destroy that store. Unmounting a component releases its React subscription. SSR stores and\ntheir derived reads belong to the request; shared clients derive from their accepted mirror\nstate. Derived definitions and caches never enter patches, history or transport payloads."},"134":{"id":"/en/docs/concepts/computed-33","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#standalone-signal-primitives","content":"`computed`, `signal` and `effect` exported by `coaction` remain alien-signals primitives. They\nare useful for independent signal graphs, but do not provide store-owned disposal or draft-aware\ncaching. Standalone computations retain conservative object dependencies. A whole root-facade\nresult needs an explicit `whole(store.getState())` read to register an aggregate dependency.\nTheir Coaction path bookkeeping lasts for the store lifetime; prefer `derive` for dynamic\nstore selectors that need dependency reclamation. Plain getters nested inside initial data are\nstill materialized as data, not recursively registered computed definitions."},"135":{"id":"/en/docs/concepts/computed-34","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#external-adapters","content":"Native accessor/getter computed behavior belongs to Coaction-owned state. External\nadapter instances do not gain Coaction's cached getters or `get(deps, selector)` semantics.\nTheir own runtime—MobX computed values, Pinia getters, selectors, or machine state—remains\nresponsible for derived state. `derive` and `derivePath` explicitly reject external adapters."},"136":{"id":"/en/docs/concepts/computed-35","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#performance-expectations","content":"Stable repeated reads are the strongest path for cached getters. Updates still preserve the\nreadonly public-state boundary and must refresh the cached snapshot before the next derived read.\nTreat microbenchmarks as regression signals, not universal claims; see the\nperformance guide for the maintained commands and interpretation."},"137":{"id":"/en/docs/concepts/computed-36","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#performance-expectations","content":"Deep tracking is suited to sparse reads. For full collection scans, keep a native getter over a\nfrozen snapshot; `derive(store, s => s.total)` can compose that getter. Reading every item through\na deep proxy adds tracking work without avoiding any evaluation. Immutable updates still copy\nchanged ancestor containers, so a flat-array scalar write is not O(depth) independent of size.\n`pnpm benchmark:derived` reports sparse workloads at 1k/10k/50k scales, full scans at 10k,\ncached reads, and writes with unread/disposed derivations. It is included in `benchmark:check`."},"138":{"id":"/en/docs/concepts/slices","page_id":"/en/docs/concepts/slices","type":"page","content":"Slices","breadcrumbs":["Coaction","Core concepts"],"tags":[],"url":"/en/docs/concepts/slices"},"139":{"id":"/en/docs/concepts/slices-0","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices","content":"Compose a native Coaction store from named state factories and update across namespaces safely."},"140":{"id":"/en/docs/concepts/slices-1","page_id":"/en/docs/concepts/slices","type":"heading","tags":[],"url":"/en/docs/concepts/slices#select-slice-fields","content":"Select slice fields"},"141":{"id":"/en/docs/concepts/slices-2","page_id":"/en/docs/concepts/slices","type":"heading","tags":[],"url":"/en/docs/concepts/slices#declare-mode-for-ambiguous-objects","content":"Declare mode for ambiguous objects"},"142":{"id":"/en/docs/concepts/slices-3","page_id":"/en/docs/concepts/slices","type":"heading","tags":[],"url":"/en/docs/concepts/slices#boundaries","content":"Boundaries"},"143":{"id":"/en/docs/concepts/slices-4","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices","content":"Slices are a native store shape for organizing Coaction-owned state into namespaces."},"144":{"id":"/en/docs/concepts/slices-5","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices","content":"Inside `set(() => ...)`, `this` targets the current slice. The explicit `draft` parameter always\nrepresents the root store, which is the right tool for cross-slice updates."},"145":{"id":"/en/docs/concepts/slices-6","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#select-slice-fields","content":"With React, `observer()` tracks the slice fields read during render:"},"146":{"id":"/en/docs/concepts/slices-7","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#select-slice-fields","content":"You can also select explicitly:"},"147":{"id":"/en/docs/concepts/slices-8","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#declare-mode-for-ambiguous-objects","content":"`sliceMode` accepts three values:"},"148":{"id":"/en/docs/concepts/slices-9","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#declare-mode-for-ambiguous-objects","content":"`'single'`: treat the input as one state object;"},"149":{"id":"/en/docs/concepts/slices-10","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#declare-mode-for-ambiguous-objects","content":"`'slices'`: require an object of slice factories;"},"150":{"id":"/en/docs/concepts/slices-11","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#declare-mode-for-ambiguous-objects","content":"`'auto'`: infer from the input shape (the compatibility default)."},"151":{"id":"/en/docs/concepts/slices-12","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#declare-mode-for-ambiguous-objects","content":"An object whose enumerable values are all functions is ambiguous: it could be a method-only\nsingle store or a map of slice factories. Development builds warn when `auto` encounters this\nshape. Make the intent explicit:"},"152":{"id":"/en/docs/concepts/slices-13","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#boundaries","content":"Slice keys and each slice's root fields are fixed after initialization."},"153":{"id":"/en/docs/concepts/slices-14","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#boundaries","content":"Methods destructured from `getState().counter` stay bound to the slice."},"154":{"id":"/en/docs/concepts/slices-15","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#boundaries","content":"Native slices work in local, shared-main, and shared-client modes."},"155":{"id":"/en/docs/concepts/slices-16","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#boundaries","content":"External-state adapters are **whole-store only** and cannot be nested as slices."},"156":{"id":"/en/docs/concepts/slices-17","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#boundaries","content":"Use slices when namespaces clarify ownership. A small store does not need to be split merely to\nimitate a folder structure."},"157":{"id":"/en/docs/concepts/state-and-actions","page_id":"/en/docs/concepts/state-and-actions","type":"page","content":"State and actions","breadcrumbs":["Coaction","Core concepts"],"tags":[],"url":"/en/docs/concepts/state-and-actions"},"158":{"id":"/en/docs/concepts/state-and-actions-0","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions","content":"Learn Coaction's immutable update boundary, fixed public schema, method binding, subscriptions, and lifecycle."},"159":{"id":"/en/docs/concepts/state-and-actions-1","page_id":"/en/docs/concepts/state-and-actions","type":"heading","tags":[],"url":"/en/docs/concepts/state-and-actions#state-is-immutable-outside-set","content":"State is immutable outside `set()`"},"160":{"id":"/en/docs/concepts/state-and-actions-2","page_id":"/en/docs/concepts/state-and-actions","type":"heading","tags":[],"url":"/en/docs/concepts/state-and-actions#the-root-schema-is-fixed","content":"The root schema is fixed"},"161":{"id":"/en/docs/concepts/state-and-actions-3","page_id":"/en/docs/concepts/state-and-actions","type":"heading","tags":[],"url":"/en/docs/concepts/state-and-actions#actions-stay-bound","content":"Actions stay bound"},"162":{"id":"/en/docs/concepts/state-and-actions-4","page_id":"/en/docs/concepts/state-and-actions","type":"heading","tags":[],"url":"/en/docs/concepts/state-and-actions#read-inspect-and-subscribe","content":"Read, inspect, and subscribe"},"163":{"id":"/en/docs/concepts/state-and-actions-5","page_id":"/en/docs/concepts/state-and-actions","type":"heading","tags":[],"url":"/en/docs/concepts/state-and-actions#patches-are-opt-in-locally","content":"Patches are opt-in locally"},"164":{"id":"/en/docs/concepts/state-and-actions-6","page_id":"/en/docs/concepts/state-and-actions","type":"heading","tags":[],"url":"/en/docs/concepts/state-and-actions#destroy-the-store-when-ownership-ends","content":"Destroy the store when ownership ends"},"165":{"id":"/en/docs/concepts/state-and-actions-7","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#state-is-immutable-outside-set","content":"Coaction exposes a readonly public state. Actions may read through `this`, but all writes to\nCoaction-owned state must happen inside `set()`:"},"166":{"id":"/en/docs/concepts/state-and-actions-8","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#state-is-immutable-outside-set","content":"You can also use the root draft explicitly:"},"167":{"id":"/en/docs/concepts/state-and-actions-9","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#state-is-immutable-outside-set","content":"A deep-partial object merges known fields. Passing `null` is a no-op. Application code should\nnormally keep updates in named store methods; direct `setState()` is useful for integration,\ntests, and controlled imperative updates."},"168":{"id":"/en/docs/concepts/state-and-actions-10","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#the-root-schema-is-fixed","content":"Coaction records the public shape during initialization. A single store cannot add unknown\ntop-level keys later. A slice store cannot add new slices or new top-level fields inside a\nslice."},"169":{"id":"/en/docs/concepts/state-and-actions-11","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#the-root-schema-is-fixed","content":"Declare a container for dynamic data:"},"170":{"id":"/en/docs/concepts/state-and-actions-12","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#the-root-schema-is-fixed","content":"Replacement-style APIs may omit a known root field in a single store. The public getter remains\npresent and reads as `undefined`. Slice root keys are stricter: a slice cannot disappear or be\nreplaced with a non-object value."},"171":{"id":"/en/docs/concepts/state-and-actions-13","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#actions-stay-bound","content":"Methods obtained from `getState()` are rebound to the latest public state at call time:"},"172":{"id":"/en/docs/concepts/state-and-actions-14","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#actions-stay-bound","content":"This makes `this` actions safe to pass to event handlers or destructure. Do not use arrow\nfunctions when the action needs `this`; arrow functions capture lexical `this`."},"173":{"id":"/en/docs/concepts/state-and-actions-15","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#read-inspect-and-subscribe","content":"Subscribers are notified after a state change is committed. Framework packages build their own\nreactive primitives on the same contract."},"174":{"id":"/en/docs/concepts/state-and-actions-16","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#patches-are-opt-in-locally","content":"Local stores use the shortest update path by default. Set `enablePatches: true` only when an\nintegration needs patch pairs:"},"175":{"id":"/en/docs/concepts/state-and-actions-17","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#patches-are-opt-in-locally","content":"Shared stores enable patch behavior because incremental synchronization depends on it. Unsafe\npatch paths containing `__proto__`, `prototype`, or `constructor` are rejected atomically."},"176":{"id":"/en/docs/concepts/state-and-actions-18","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#destroy-the-store-when-ownership-ends","content":"`destroy()` clears subscriptions, runs registered integration cleanup, and disposes transports.\nOperations after destruction are rejected. Components normally let their framework wrapper\nmanage subscription cleanup, but dynamically created stores, Yjs bindings, and custom transports\nstill need an explicit ownership plan."},"177":{"id":"/en/docs/concepts/store-modes","page_id":"/en/docs/concepts/store-modes","type":"page","content":"Store modes and entry points","breadcrumbs":["Coaction","Core concepts"],"tags":[],"url":"/en/docs/concepts/store-modes"},"178":{"id":"/en/docs/concepts/store-modes-0","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Understand local stores, shared authorities, client mirrors, and Coaction's isolated package boundaries."},"179":{"id":"/en/docs/concepts/store-modes-1","page_id":"/en/docs/concepts/store-modes","type":"heading","tags":[],"url":"/en/docs/concepts/store-modes#local-mode","content":"Local mode"},"180":{"id":"/en/docs/concepts/store-modes-2","page_id":"/en/docs/concepts/store-modes","type":"heading","tags":[],"url":"/en/docs/concepts/store-modes#shared-main-mode","content":"Shared main mode"},"181":{"id":"/en/docs/concepts/store-modes-3","page_id":"/en/docs/concepts/store-modes","type":"heading","tags":[],"url":"/en/docs/concepts/store-modes#shared-client-mode","content":"Shared client mode"},"182":{"id":"/en/docs/concepts/store-modes-4","page_id":"/en/docs/concepts/store-modes","type":"heading","tags":[],"url":"/en/docs/concepts/store-modes#isolated-entry-points","content":"Isolated entry points"},"183":{"id":"/en/docs/concepts/store-modes-5","page_id":"/en/docs/concepts/store-modes","type":"heading","tags":[],"url":"/en/docs/concepts/store-modes#three-things-the-word-sync-gets-used-for","content":"Three things the word \"sync\" gets used for"},"184":{"id":"/en/docs/concepts/store-modes-6","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"The same public store contract appears in three runtime modes."},"185":{"id":"/en/docs/concepts/store-modes-7","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Mode"},"186":{"id":"/en/docs/concepts/store-modes-8","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"`store.share`"},"187":{"id":"/en/docs/concepts/store-modes-9","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Mutation authority"},"188":{"id":"/en/docs/concepts/store-modes-10","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Method result"},"189":{"id":"/en/docs/concepts/store-modes-11","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Local"},"190":{"id":"/en/docs/concepts/store-modes-12","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"`false`"},"191":{"id":"/en/docs/concepts/store-modes-13","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Current runtime"},"192":{"id":"/en/docs/concepts/store-modes-14","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Synchronous"},"193":{"id":"/en/docs/concepts/store-modes-15","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Shared main"},"194":{"id":"/en/docs/concepts/store-modes-16","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"`'main'`"},"195":{"id":"/en/docs/concepts/store-modes-17","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Main runtime"},"196":{"id":"/en/docs/concepts/store-modes-18","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Synchronous on the authority"},"197":{"id":"/en/docs/concepts/store-modes-19","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Shared client"},"198":{"id":"/en/docs/concepts/store-modes-20","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"`'client'`"},"199":{"id":"/en/docs/concepts/store-modes-21","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Main runtime"},"200":{"id":"/en/docs/concepts/store-modes-22","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Promise returned to the client"},"201":{"id":"/en/docs/concepts/store-modes-23","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#local-mode","content":"Local mode owns state and