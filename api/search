e narrowest Coaction entry point and framework package for your application."},"40":{"id":"/en/docs/getting-started/installation-1","page_id":"/en/docs/getting-started/installation","type":"heading","tags":[],"url":"/en/docs/getting-started/installation#vanilla-applications","content":"Vanilla applications"},"41":{"id":"/en/docs/getting-started/installation-2","page_id":"/en/docs/getting-started/installation","type":"heading","tags":[],"url":"/en/docs/getting-started/installation#framework-packages","content":"Framework packages"},"42":{"id":"/en/docs/getting-started/installation-3","page_id":"/en/docs/getting-started/installation","type":"heading","tags":[],"url":"/en/docs/getting-started/installation#optional-integrations","content":"Optional integrations"},"43":{"id":"/en/docs/getting-started/installation-4","page_id":"/en/docs/getting-started/installation","type":"heading","tags":[],"url":"/en/docs/getting-started/installation#entry-point-map","content":"Entry-point map"},"44":{"id":"/en/docs/getting-started/installation-5","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation","content":"Coaction requires Node.js 22 or newer for repository development. Published runtime packages are\ninstalled from npm with the package manager you already use."},"45":{"id":"/en/docs/getting-started/installation-6","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#vanilla-applications","content":"For a local-only store, install the core and import the transport-free entry:"},"46":{"id":"/en/docs/getting-started/installation-7","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#vanilla-applications","content":"The default entry is the single-context runtime. No transport is reachable from\nit, so the JSON protocol, epoch, reconnect and transport runtime stay out of the\nbundle entirely."},"47":{"id":"/en/docs/getting-started/installation-8","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#vanilla-applications","content":"Use the shared entry when state crosses a Worker, SharedWorker, or injected transport boundary:"},"48":{"id":"/en/docs/getting-started/installation-9","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"Install the core plus one framework binding:"},"49":{"id":"/en/docs/getting-started/installation-10","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"Framework"},"50":{"id":"/en/docs/getting-started/installation-11","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"Package"},"51":{"id":"/en/docs/getting-started/installation-12","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"Primary reactive API"},"52":{"id":"/en/docs/getting-started/installation-13","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"React 18–19"},"53":{"id":"/en/docs/getting-started/installation-14","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"`@coaction/react`"},"54":{"id":"/en/docs/getting-started/installation-15","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"`create()`, `observer()`, `<Observer>`"},"55":{"id":"/en/docs/getting-started/installation-16","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"Vue"},"56":{"id":"/en/docs/getting-started/installation-17","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"`@coaction/vue`"},"57":{"id":"/en/docs/getting-started/installation-18","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"callable store and computed selectors"},"58":{"id":"/en/docs/getting-started/installation-19","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"Angular"},"59":{"id":"/en/docs/getting-started/installation-20","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"`@coaction/ng`"},"60":{"id":"/en/docs/getting-started/installation-21","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"`store.select()` signal"},"61":{"id":"/en/docs/getting-started/installation-22","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"Svelte"},"62":{"id":"/en/docs/getting-started/installation-23","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"`@coaction/svelte`"},"63":{"id":"/en/docs/getting-started/installation-24","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"readable selector store"},"64":{"id":"/en/docs/getting-started/installation-25","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"Solid"},"65":{"id":"/en/docs/getting-started/installation-26","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"`@coaction/solid`"},"66":{"id":"/en/docs/getting-started/installation-27","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"selector accessor"},"67":{"id":"/en/docs/getting-started/installation-28","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#framework-packages","content":"See framework integrations for runnable examples."},"68":{"id":"/en/docs/getting-started/installation-29","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#optional-integrations","content":"Install only the integration that owns or decorates your state:"},"69":{"id":"/en/docs/getting-started/installation-30","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#optional-integrations","content":"External-state adapters are whole-store bridges. Do not place a Zustand, MobX, Pinia, Jotai,\nRedux, Valtio, or XState adapter under a native Coaction slice key."},"70":{"id":"/en/docs/getting-started/installation-31","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#entry-point-map","content":"Import"},"71":{"id":"/en/docs/getting-started/installation-32","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#entry-point-map","content":"Intended audience"},"72":{"id":"/en/docs/getting-started/installation-33","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#entry-point-map","content":"`coaction`"},"73":{"id":"/en/docs/getting-started/installation-34","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#entry-point-map","content":"Local vanilla stores and signal primitives"},"74":{"id":"/en/docs/getting-started/installation-35","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#entry-point-map","content":"`coaction/shared`"},"75":{"id":"/en/docs/getting-started/installation-36","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#entry-point-map","content":"Local stores, shared authorities, and client mirrors"},"76":{"id":"/en/docs/getting-started/installation-37","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#entry-point-map","content":"`coaction/adapter`"},"77":{"id":"/en/docs/getting-started/installation-38","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#entry-point-map","content":"Authors of external-store adapters and low-level middleware"},"78":{"id":"/en/docs/getting-started/installation-39","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#entry-point-map","content":"Do not deploy a new shared client against an authority running a different\nCoaction major. Upgrade the Worker/SharedWorker authority and all clients as\none deployment unit."},"79":{"id":"/en/docs/getting-started/installation-40","page_id":"/en/docs/getting-started/installation","tags":[],"type":"text","url":"/en/docs/getting-started/installation#entry-point-map","content":"Next, create a store."},"80":{"id":"/en/docs/getting-started/quick-start","page_id":"/en/docs/getting-started/quick-start","type":"page","content":"Quick start","breadcrumbs":["Coaction","Getting started"],"tags":[],"url":"/en/docs/getting-started/quick-start"},"81":{"id":"/en/docs/getting-started/quick-start-0","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start","content":"Create a React store with immutable updates, cached derived state, and precise render tracking."},"82":{"id":"/en/docs/getting-started/quick-start-1","page_id":"/en/docs/getting-started/quick-start","type":"heading","tags":[],"url":"/en/docs/getting-started/quick-start#1-create-the-store","content":"1\\. Create the store"},"83":{"id":"/en/docs/getting-started/quick-start-2","page_id":"/en/docs/getting-started/quick-start","type":"heading","tags":[],"url":"/en/docs/getting-started/quick-start#2-render-it-precisely","content":"2\\. Render it precisely"},"84":{"id":"/en/docs/getting-started/quick-start-3","page_id":"/en/docs/getting-started/quick-start","type":"heading","tags":[],"url":"/en/docs/getting-started/quick-start#3-use-explicit-selectors-when-they-are-clearer","content":"3\\. Use explicit selectors when they are clearer"},"85":{"id":"/en/docs/getting-started/quick-start-4","page_id":"/en/docs/getting-started/quick-start","type":"heading","tags":[],"url":"/en/docs/getting-started/quick-start#4-use-the-imperative-store-api-outside-react","content":"4\\. Use the imperative store API outside React"},"86":{"id":"/en/docs/getting-started/quick-start-5","page_id":"/en/docs/getting-started/quick-start","type":"heading","tags":[],"url":"/en/docs/getting-started/quick-start#next-steps","content":"Next steps"},"87":{"id":"/en/docs/getting-started/quick-start-6","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start","content":"This example uses React because it shows state creation and render tracking in one place. The\nunderlying store model is the same in every framework."},"88":{"id":"/en/docs/getting-started/quick-start-7","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#1-create-the-store","content":"The accessor getter is cached. Coaction records which state fields it reads and recomputes it\nonly after one of those dependencies changes."},"89":{"id":"/en/docs/getting-started/quick-start-8","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#1-create-the-store","content":"`set()` opens an immutable update boundary. Code inside the callback edits a Mutative draft;\nsubscribers receive the committed next state."},"90":{"id":"/en/docs/getting-started/quick-start-9","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#2-render-it-precisely","content":"Inside `observer()`, `useCounter()` tracks the fields read during render. The component above\ndepends on `count`, `doubled`, and the `increment` method; unrelated store fields do not cause it\nto render again."},"91":{"id":"/en/docs/getting-started/quick-start-10","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#2-render-it-precisely","content":"Without `observer()`, calling `useCounter()` subscribes to the whole store. That behavior is\nuseful when the store is small or a component intentionally observes everything."},"92":{"id":"/en/docs/getting-started/quick-start-11","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#3-use-explicit-selectors-when-they-are-clearer","content":"Automatic tracking is optional:"},"93":{"id":"/en/docs/getting-started/quick-start-12","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#3-use-explicit-selectors-when-they-are-clearer","content":"The selector runs inside a reactive tracker, so the paths it reads become its dependencies: a\nwrite that touches none of them does not re-run it at all. `Object.is` still decides the\nre-render, but most writes never reach the comparison. For frequently reused field selectors,\ncreate a cached selector map once:"},"94":{"id":"/en/docs/getting-started/quick-start-13","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#4-use-the-imperative-store-api-outside-react","content":"Framework stores retain the core store contract:"},"95":{"id":"/en/docs/getting-started/quick-start-14","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#4-use-the-imperative-store-api-outside-react","content":"`getState()` includes data, methods, and getters. `getPureState()` returns only the data view and\nis the better choice for logging, serialization, and tests."},"96":{"id":"/en/docs/getting-started/quick-start-15","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#next-steps","content":"<Card title=\"State and actions\" href=\"/en/docs/concepts/state-and-actions\" description=\"Understand writes, schema, subscriptions, and lifecycle.\" />"},"97":{"id":"/en/docs/getting-started/quick-start-16","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#next-steps","content":"<Card title=\"Computed state\" href=\"/en/docs/concepts/computed\" description=\"Choose between accessor getters and explicit dependencies.\" />"},"98":{"id":"/en/docs/getting-started/quick-start-17","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#next-steps","content":"<Card title=\"Slices\" href=\"/en/docs/concepts/slices\" description=\"Organize a larger native store into namespaces.\" />"},"99":{"id":"/en/docs/getting-started/quick-start-18","page_id":"/en/docs/getting-started/quick-start","tags":[],"type":"text","url":"/en/docs/getting-started/quick-start#next-steps","content":"<Card title=\"Shared runtime\" href=\"/en/docs/shared/overview\" description=\"Move method execution into a worker authority.\" />"},"100":{"id":"/en/docs/concepts/computed","page_id":"/en/docs/concepts/computed","type":"page","content":"Computed state","breadcrumbs":["Coaction","Core concepts"],"tags":[],"url":"/en/docs/concepts/computed"},"101":{"id":"/en/docs/concepts/computed-0","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed","content":"Choose frozen getter snapshots, explicit paths, or managed deep selectors."},"102":{"id":"/en/docs/concepts/computed-1","page_id":"/en/docs/concepts/computed","type":"heading","tags":[],"url":"/en/docs/concepts/computed#accessor-getters","content":"Accessor getters"},"103":{"id":"/en/docs/concepts/computed-2","page_id":"/en/docs/concepts/computed","type":"heading","tags":[],"url":"/en/docs/concepts/computed#explicit-dependencies-with-get","content":"Explicit dependencies with `get()`"},"104":{"id":"/en/docs/concepts/computed-3","page_id":"/en/docs/concepts/computed","type":"heading","tags":[],"url":"/en/docs/concepts/computed#tracking-granularity","content":"Tracking granularity"},"105":{"id":"/en/docs/concepts/computed-4","page_id":"/en/docs/concepts/computed","type":"heading","tags":[],"url":"/en/docs/concepts/computed#managed-derived-reads","content":"Managed derived reads"},"106":{"id":"/en/docs/concepts/computed-5","page_id":"/en/docs/concepts/computed","type":"heading","tags":[],"url":"/en/docs/concepts/computed#object-identity-is-a-separate-dependency","content":"Object identity is a separate dependency"},"107":{"id":"/en/docs/concepts/computed-6","page_id":"/en/docs/concepts/computed","type":"heading","tags":[],"url":"/en/docs/concepts/computed#result-equality","content":"Result equality"},"108":{"id":"/en/docs/concepts/computed-7","page_id":"/en/docs/concepts/computed","type":"heading","tags":[],"url":"/en/docs/concepts/computed#transactions-ownership-and-react","content":"Transactions, ownership and React"},"109":{"id":"/en/docs/concepts/computed-8","page_id":"/en/docs/concepts/computed","type":"heading","tags":[],"url":"/en/docs/concepts/computed#standalone-signal-primitives","content":"Standalone signal primitives"},"110":{"id":"/en/docs/concepts/computed-9","page_id":"/en/docs/concepts/computed","type":"heading","tags":[],"url":"/en/docs/concepts/computed#external-adapters","content":"External adapters"},"111":{"id":"/en/docs/concepts/computed-10","page_id":"/en/docs/concepts/computed","type":"heading","tags":[],"url":"/en/docs/concepts/computed#performance-expectations","content":"Performance expectations"},"112":{"id":"/en/docs/concepts/computed-11","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed","content":"Coaction's computed values use the same signal graph as field tracking. A component can read a\ncached getter, that getter can read store fields, and invalidation flows through the graph without\nmanual memo arrays."},"113":{"id":"/en/docs/concepts/computed-12","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#accessor-getters","content":"Use a normal getter for the default derived-state experience:"},"114":{"id":"/en/docs/concepts/computed-13","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#accessor-getters","content":"`subtotal` is cached until `items` changes. `total` depends on the cached `subtotal` and\n`taxRate`; those relationships are discovered automatically."},"115":{"id":"/en/docs/concepts/computed-14","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#accessor-getters","content":"Keep getters pure. A getter should not call `setState()`, mutate external state, or produce a\ndifferent result from hidden side effects."},"116":{"id":"/en/docs/concepts/computed-15","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#explicit-dependencies-with-get","content":"The second argument passed to a store factory can declare dependencies manually:"},"117":{"id":"/en/docs/concepts/computed-16","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#explicit-dependencies-with-get","content":"Use this form when dependency declaration makes cross-slice logic clearer, or when integration\ncode should not rely on implicit getter reads."},"118":{"id":"/en/docs/concepts/computed-17","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#explicit-dependencies-with-get","content":"Calling `get()` without arguments returns the current root state. In a slice factory this is a\nconvenient way to read another namespace, though update logic should still happen through\n`set()`."},"119":{"id":"/en/docs/concepts/computed-18","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#tracking-granularity","content":"Native getters and `get(deps, fn)` read frozen snapshots at the store/slice field boundary.\nReading `this.user.name` in a getter therefore invalidates that getter when `user.age` changes.\nWith `get(s => [s.user.name], fn)`, the dependency selector runs again, but `fn` can reuse its\nresult when the selected name is unchanged. Recomputing a getter and notifying its consumers\nare separate: an unchanged primitive result can suppress downstream work."},"120":{"id":"/en/docs/concepts/computed-19","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#tracking-granularity","content":"React selectors and `observer` use managed deep path tracking. A selector reading\n`state.user.name` can ignore an age-only recipe update. Parent replacement, array structure,\nand graph snapshot patches can invalidate more broadly. Array elements are read as values: a\nreader of `state.todos[0].title` depends on `todos[0]` itself, so an `observer` re-renders after\nany write inside that element, while a selector reruns but re-renders only when its result\nchanges."},"121":{"id":"/en/docs/concepts/computed-20","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#managed-derived-reads","content":"The optional `coaction/derived` entry adds store-owned cached reads without changing native\ngetter defaults or adding this runtime to the default entry's consumer bundle:"},"122":{"id":"/en/docs/concepts/computed-21","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#managed-derived-reads","content":"`derivePath` copies the path when created, supports string/number/symbol keys, and returns\n`undefined` for missing data. It selects data, not methods or native computed getters. Use\n`derive` to compose getters or to select a path dynamically. There is no incremental `reduce`,\n`filter`, or `sort` algorithm hidden behind either API."},"123":{"id":"/en/docs/concepts/computed-22","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#object-identity-is-a-separate-dependency","content":"`derive(store, selector)` conservatively retains traversed object identities by default.\n`{ deep: true }` opts into value selection: traversing an object to reach a child does not\nautomatically retain the parent's identity. JavaScript `===`, `Object.is`, and WeakMap lookups\ncannot be detected by property traps. Mark these uses explicitly:"},"124":{"id":"/en/docs/concepts/computed-23","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#object-identity-is-a-separate-dependency","content":"An age change must rerun this selector because it replaces the `user` object, even though the\nname is unchanged. `identity()` returns the same readonly object; `whole()` instead returns\nowned raw data for coarse scans, which must never be mutated."},"125":{"id":"/en/docs/concepts/computed-24","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#object-identity-is-a-separate-dependency","content":"Array elements are values rather than readonly proxies. An element read by index, found by a\nscan or returned by a getter is the frozen element itself, so it compares equal however it was\nreached, and an object also held at an object key has one identity across both. Reading an\nelement depends on its identity: any write inside an element gives it a new identity, while\nwrites to its siblings do not. A write to an element outside `set()` throws a\n`TypeError` in strict-mode code and is silently ignored in sloppy-mode scripts; either way the\nstate is unchanged."},"126":{"id":"/en/docs/concepts/computed-25","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#object-identity-is-a-separate-dependency","content":"Array methods that read every element without changing it, such as `filter`, `map`, `find`,\n`reduce`, `slice` and `for...of`, take one dependency on the array and run over the array itself.\nReads of other state inside the callback are tracked as usual. Use `whole()` for traversals that\nare not a single array method, such as an indexed loop or the values of a record."},"127":{"id":"/en/docs/concepts/computed-26","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#object-identity-is-a-separate-dependency","content":"Returning a state object directly, or carrying it inside ordinary object/array data wrappers,\nretains its terminal dependency automatically. Cyclic wrappers are supported. Output accessors\nare not invoked, and opaque instances, functions and closures are not traversed: mark any state\nobjects captured there with `identity()` during selection. Arrays, holes, symbols, null\nprototypes, cycles and shared references retain the local-state contract. Date, Map, Set and\nclass instances remain atomic identity leaves; their internal mutations are not made reactive."},"128":{"id":"/en/docs/concepts/computed-27","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#result-equality","content":"Result comparison defaults to `Object.is`, including its NaN and signed-zero behavior. A fresh\nobject result is different even when its fields are equal. Supply `equals` to reuse equivalent\nderived data:"},"129":{"id":"/en/docs/concepts/computed-28","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#result-equality","content":"Comparison is independent of dependency selection and runs without collecting dependencies.\nEven when a result is reused, branch dependencies are reconciled. The comparator must be pure.\nChanges to state objects carried in the output still propagate, including live root/slice\nfacades: result equality does not hide a change to their state. Structural equality of arbitrary\nlocal graphs is not the default."},"130":{"id":"/en/docs/concepts/computed-29","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#transactions-ownership-and-react","content":"Reads inside a recipe evaluate against that store's current draft without installing a cache\nor retaining draft proxies. Failed recipes and validator vetoes leave the committed cache intact;\nconsumers are invalidated after an accepted commit. Selector failures remain failures on cached\nreads and retry when a dependency changes. Compose derivations owned by the same store; this API\ndoes not coordinate transactions between different stores. Selectors must be synchronous pure\nreads. Work after `await` is outside dependency collection; this is not a Resource/Suspense API."},"131":{"id":"/en/docs/concepts/computed-30","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#transactions-ownership-and-react","content":"Each read keeps its current dependencies until `dispose()` or `store.destroy()`. Unread\nderivations do not activate patches. Disposing is idempotent, releases the read's dependencies\nand cache, and makes subsequent calls throw. Stopping a consumer does not dispose a store-owned\nderivation: it stays available for other consumers. Native getter caches have their own existing\nstore lifetime."},"132":{"id":"/en/docs/concepts/computed-31","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#transactions-ownership-and-react","content":"Create derivations with their store or another explicit owner, outside React render. Creating\none in a render or relying on `useMemo` as a cleanup boundary can retain abandoned instances.\nAn existing store-owned read works in a selector or an observer:"},"133":{"id":"/en/docs/concepts/computed-32","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#transactions-ownership-and-react","content":"Here `usePerson` is a store from `@coaction/react`. Dispose `displayName` when its owner ends,\nor destroy that store. Unmounting a component releases its React subscription. SSR stores and\ntheir derived reads belong to the request; shared clients derive from their accepted mirror\nstate. Derived definitions and caches never enter patches, history or transport payloads."},"134":{"id":"/en/docs/concepts/computed-33","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#standalone-signal-primitives","content":"`computed`, `signal` and `effect` exported by `coaction` remain alien-signals primitives. They\nare useful for independent signal graphs, but do not provide store-owned disposal or draft-aware\ncaching. Standalone computations retain conservative object dependencies. A whole root-facade\nresult needs an explicit `whole(store.getState())` read to register an aggregate dependency.\nTheir Coaction path bookkeeping lasts for the store lifetime; prefer `derive` for dynamic\nstore selectors that need dependency reclamation. Plain getters nested inside initial data are\nstill materialized as data, not recursively registered computed definitions."},"135":{"id":"/en/docs/concepts/computed-34","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#external-adapters","content":"Native accessor/getter computed behavior belongs to Coaction-owned state. External\nadapter instances do not gain Coaction's cached getters or `get(deps, selector)` semantics.\nTheir own runtime—MobX computed values, Pinia getters, selectors, or machine state—remains\nresponsible for derived state. `derive` and `derivePath` explicitly reject external adapters."},"136":{"id":"/en/docs/concepts/computed-35","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#performance-expectations","content":"Stable repeated reads are the strongest path for cached getters. Updates still preserve the\nreadonly public-state boundary and must refresh the cached snapshot before the next derived read.\nTreat microbenchmarks as regression signals, not universal claims; see the\nperformance guide for the maintained commands and interpretation."},"137":{"id":"/en/docs/concepts/computed-36","page_id":"/en/docs/concepts/computed","tags":[],"type":"text","url":"/en/docs/concepts/computed#performance-expectations","content":"Deep tracking is suited to sparse reads. For full collection scans, keep a native getter over a\nfrozen snapshot; `derive(store, s => s.total)` can compose that getter. Reading every item through\na deep proxy adds tracking work without avoiding any evaluation. Immutable updates still copy\nchanged ancestor containers, so a flat-array scalar write is not O(depth) independent of size.\n`pnpm benchmark:derived` reports sparse workloads at 1k/10k/50k scales, full scans at 10k,\ncached reads, and writes with unread/disposed derivations. It is included in `benchmark:check`."},"138":{"id":"/en/docs/concepts/slices","page_id":"/en/docs/concepts/slices","type":"page","content":"Slices","breadcrumbs":["Coaction","Core concepts"],"tags":[],"url":"/en/docs/concepts/slices"},"139":{"id":"/en/docs/concepts/slices-0","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices","content":"Compose a native Coaction store from named state factories and update across namespaces safely."},"140":{"id":"/en/docs/concepts/slices-1","page_id":"/en/docs/concepts/slices","type":"heading","tags":[],"url":"/en/docs/concepts/slices#select-slice-fields","content":"Select slice fields"},"141":{"id":"/en/docs/concepts/slices-2","page_id":"/en/docs/concepts/slices","type":"heading","tags":[],"url":"/en/docs/concepts/slices#declare-mode-for-ambiguous-objects","content":"Declare mode for ambiguous objects"},"142":{"id":"/en/docs/concepts/slices-3","page_id":"/en/docs/concepts/slices","type":"heading","tags":[],"url":"/en/docs/concepts/slices#boundaries","content":"Boundaries"},"143":{"id":"/en/docs/concepts/slices-4","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices","content":"Slices are a native store shape for organizing Coaction-owned state into namespaces."},"144":{"id":"/en/docs/concepts/slices-5","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices","content":"Inside `set(() => ...)`, `this` targets the current slice. The explicit `draft` parameter always\nrepresents the root store, which is the right tool for cross-slice updates."},"145":{"id":"/en/docs/concepts/slices-6","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#select-slice-fields","content":"With React, `observer()` tracks the slice fields read during render:"},"146":{"id":"/en/docs/concepts/slices-7","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#select-slice-fields","content":"You can also select explicitly:"},"147":{"id":"/en/docs/concepts/slices-8","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#declare-mode-for-ambiguous-objects","content":"`sliceMode` accepts three values:"},"148":{"id":"/en/docs/concepts/slices-9","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#declare-mode-for-ambiguous-objects","content":"`'single'`: treat the input as one state object;"},"149":{"id":"/en/docs/concepts/slices-10","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#declare-mode-for-ambiguous-objects","content":"`'slices'`: require an object of slice factories;"},"150":{"id":"/en/docs/concepts/slices-11","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#declare-mode-for-ambiguous-objects","content":"`'auto'`: infer from the input shape (the compatibility default)."},"151":{"id":"/en/docs/concepts/slices-12","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#declare-mode-for-ambiguous-objects","content":"An object whose enumerable values are all functions is ambiguous: it could be a method-only\nsingle store or a map of slice factories. Development builds warn when `auto` encounters this\nshape. Make the intent explicit:"},"152":{"id":"/en/docs/concepts/slices-13","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#boundaries","content":"Slice keys and each slice's root fields are fixed after initialization."},"153":{"id":"/en/docs/concepts/slices-14","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#boundaries","content":"Methods destructured from `getState().counter` stay bound to the slice."},"154":{"id":"/en/docs/concepts/slices-15","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#boundaries","content":"Native slices work in local, shared-main, and shared-client modes."},"155":{"id":"/en/docs/concepts/slices-16","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#boundaries","content":"External-state adapters are **whole-store only** and cannot be nested as slices."},"156":{"id":"/en/docs/concepts/slices-17","page_id":"/en/docs/concepts/slices","tags":[],"type":"text","url":"/en/docs/concepts/slices#boundaries","content":"Use slices when namespaces clarify ownership. A small store does not need to be split merely to\nimitate a folder structure."},"157":{"id":"/en/docs/concepts/state-and-actions","page_id":"/en/docs/concepts/state-and-actions","type":"page","content":"State and actions","breadcrumbs":["Coaction","Core concepts"],"tags":[],"url":"/en/docs/concepts/state-and-actions"},"158":{"id":"/en/docs/concepts/state-and-actions-0","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions","content":"Learn Coaction's immutable update boundary, fixed public schema, method binding, subscriptions, and lifecycle."},"159":{"id":"/en/docs/concepts/state-and-actions-1","page_id":"/en/docs/concepts/state-and-actions","type":"heading","tags":[],"url":"/en/docs/concepts/state-and-actions#state-is-immutable-outside-set","content":"State is immutable outside `set()`"},"160":{"id":"/en/docs/concepts/state-and-actions-2","page_id":"/en/docs/concepts/state-and-actions","type":"heading","tags":[],"url":"/en/docs/concepts/state-and-actions#the-root-schema-is-fixed","content":"The root schema is fixed"},"161":{"id":"/en/docs/concepts/state-and-actions-3","page_id":"/en/docs/concepts/state-and-actions","type":"heading","tags":[],"url":"/en/docs/concepts/state-and-actions#actions-stay-bound","content":"Actions stay bound"},"162":{"id":"/en/docs/concepts/state-and-actions-4","page_id":"/en/docs/concepts/state-and-actions","type":"heading","tags":[],"url":"/en/docs/concepts/state-and-actions#read-inspect-and-subscribe","content":"Read, inspect, and subscribe"},"163":{"id":"/en/docs/concepts/state-and-actions-5","page_id":"/en/docs/concepts/state-and-actions","type":"heading","tags":[],"url":"/en/docs/concepts/state-and-actions#patches-are-opt-in-locally","content":"Patches are opt-in locally"},"164":{"id":"/en/docs/concepts/state-and-actions-6","page_id":"/en/docs/concepts/state-and-actions","type":"heading","tags":[],"url":"/en/docs/concepts/state-and-actions#destroy-the-store-when-ownership-ends","content":"Destroy the store when ownership ends"},"165":{"id":"/en/docs/concepts/state-and-actions-7","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#state-is-immutable-outside-set","content":"Coaction exposes a readonly public state. Actions may read through `this`, but all writes to\nCoaction-owned state must happen inside `set()`:"},"166":{"id":"/en/docs/concepts/state-and-actions-8","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#state-is-immutable-outside-set","content":"You can also use the root draft explicitly:"},"167":{"id":"/en/docs/concepts/state-and-actions-9","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#state-is-immutable-outside-set","content":"A deep-partial object merges known fields. Passing `null` is a no-op. Application code should\nnormally keep updates in named store methods; direct `setState()` is useful for integration,\ntests, and controlled imperative updates."},"168":{"id":"/en/docs/concepts/state-and-actions-10","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#the-root-schema-is-fixed","content":"Coaction records the public shape during initialization. A single store cannot add unknown\ntop-level keys later. A slice store cannot add new slices or new top-level fields inside a\nslice."},"169":{"id":"/en/docs/concepts/state-and-actions-11","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#the-root-schema-is-fixed","content":"Declare a container for dynamic data:"},"170":{"id":"/en/docs/concepts/state-and-actions-12","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#the-root-schema-is-fixed","content":"Replacement-style APIs may omit a known root field in a single store. The public getter remains\npresent and reads as `undefined`. Slice root keys are stricter: a slice cannot disappear or be\nreplaced with a non-object value."},"171":{"id":"/en/docs/concepts/state-and-actions-13","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#actions-stay-bound","content":"Methods obtained from `getState()` are rebound to the latest public state at call time:"},"172":{"id":"/en/docs/concepts/state-and-actions-14","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#actions-stay-bound","content":"This makes `this` actions safe to pass to event handlers or destructure. Do not use arrow\nfunctions when the action needs `this`; arrow functions capture lexical `this`."},"173":{"id":"/en/docs/concepts/state-and-actions-15","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#read-inspect-and-subscribe","content":"Subscribers are notified after a state change is committed. Framework packages build their own\nreactive primitives on the same contract."},"174":{"id":"/en/docs/concepts/state-and-actions-16","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#patches-are-opt-in-locally","content":"Local stores use the shortest update path by default. Set `enablePatches: true` only when an\nintegration needs patch pairs:"},"175":{"id":"/en/docs/concepts/state-and-actions-17","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#patches-are-opt-in-locally","content":"Shared stores enable patch behavior because incremental synchronization depends on it. Unsafe\npatch paths containing `__proto__`, `prototype`, or `constructor` are rejected atomically."},"176":{"id":"/en/docs/concepts/state-and-actions-18","page_id":"/en/docs/concepts/state-and-actions","tags":[],"type":"text","url":"/en/docs/concepts/state-and-actions#destroy-the-store-when-ownership-ends","content":"`destroy()` clears subscriptions, runs registered integration cleanup, and disposes transports.\nOperations after destruction are rejected. Components normally let their framework wrapper\nmanage subscription cleanup, but dynamically created stores, Yjs bindings, and custom transports\nstill need an explicit ownership plan."},"177":{"id":"/en/docs/concepts/store-modes","page_id":"/en/docs/concepts/store-modes","type":"page","content":"Store modes and entry points","breadcrumbs":["Coaction","Core concepts"],"tags":[],"url":"/en/docs/concepts/store-modes"},"178":{"id":"/en/docs/concepts/store-modes-0","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Understand local stores, shared authorities, client mirrors, and Coaction's isolated package boundaries."},"179":{"id":"/en/docs/concepts/store-modes-1","page_id":"/en/docs/concepts/store-modes","type":"heading","tags":[],"url":"/en/docs/concepts/store-modes#local-mode","content":"Local mode"},"180":{"id":"/en/docs/concepts/store-modes-2","page_id":"/en/docs/concepts/store-modes","type":"heading","tags":[],"url":"/en/docs/concepts/store-modes#shared-main-mode","content":"Shared main mode"},"181":{"id":"/en/docs/concepts/store-modes-3","page_id":"/en/docs/concepts/store-modes","type":"heading","tags":[],"url":"/en/docs/concepts/store-modes#shared-client-mode","content":"Shared client mode"},"182":{"id":"/en/docs/concepts/store-modes-4","page_id":"/en/docs/concepts/store-modes","type":"heading","tags":[],"url":"/en/docs/concepts/store-modes#isolated-entry-points","content":"Isolated entry points"},"183":{"id":"/en/docs/concepts/store-modes-5","page_id":"/en/docs/concepts/store-modes","type":"heading","tags":[],"url":"/en/docs/concepts/store-modes#three-things-the-word-sync-gets-used-for","content":"Three things the word \"sync\" gets used for"},"184":{"id":"/en/docs/concepts/store-modes-6","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"The same public store contract appears in three runtime modes."},"185":{"id":"/en/docs/concepts/store-modes-7","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Mode"},"186":{"id":"/en/docs/concepts/store-modes-8","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"`store.share`"},"187":{"id":"/en/docs/concepts/store-modes-9","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Mutation authority"},"188":{"id":"/en/docs/concepts/store-modes-10","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Method result"},"189":{"id":"/en/docs/concepts/store-modes-11","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Local"},"190":{"id":"/en/docs/concepts/store-modes-12","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"`false`"},"191":{"id":"/en/docs/concepts/store-modes-13","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Current runtime"},"192":{"id":"/en/docs/concepts/store-modes-14","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Synchronous"},"193":{"id":"/en/docs/concepts/store-modes-15","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Shared main"},"194":{"id":"/en/docs/concepts/store-modes-16","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"`'main'`"},"195":{"id":"/en/docs/concepts/store-modes-17","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Main runtime"},"196":{"id":"/en/docs/concepts/store-modes-18","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Synchronous on the authority"},"197":{"id":"/en/docs/concepts/store-modes-19","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Shared client"},"198":{"id":"/en/docs/concepts/store-modes-20","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"`'client'`"},"199":{"id":"/en/docs/concepts/store-modes-21","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Main runtime"},"200":{"id":"/en/docs/concepts/store-modes-22","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes","content":"Promise returned to the client"},"201":{"id":"/en/docs/concepts/store-modes-23","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#local-mode","content":"Local mode owns state and execution in one runtime. It keeps patch generation off unless you\nexplicitly enable it, making it the recommended starting point."},"202":{"id":"/en/docs/concepts/store-modes-24","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#shared-main-mode","content":"A store becomes a shared authority when it owns a main transport or runs in the detected worker\nauthority environment:"},"203":{"id":"/en/docs/concepts/store-modes-25","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#shared-main-mode","content":"The main store executes actions, commits state, emits ordered patches, and serves full snapshots."},"204":{"id":"/en/docs/concepts/store-modes-26","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#shared-client-mode","content":"Passing a `Worker`, `SharedWorker`, or client transport creates a mirror:"},"205":{"id":"/en/docs/concepts/store-modes-27","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#shared-client-mode","content":"Client methods are async because execution happens on the authority. The client may read and\nsubscribe to mirrored state, but direct `setState()` and `apply()` calls are rejected."},"206":{"id":"/en/docs/concepts/store-modes-28","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#isolated-entry-points","content":"The package exposes static boundaries so a bundler can avoid loading unrelated runtime code:"},"207":{"id":"/en/docs/concepts/store-modes-29","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#isolated-entry-points","content":"Entry"},"208":{"id":"/en/docs/concepts/store-modes-30","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#isolated-entry-points","content":"Contains"},"209":{"id":"/en/docs/concepts/store-modes-31","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#isolated-entry-points","content":"`coaction`"},"210":{"id":"/en/docs/concepts/store-modes-32","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#isolated-entry-points","content":"Local creation, lifecycle helpers, signal primitives"},"211":{"id":"/en/docs/concepts/store-modes-33","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#isolated-entry-points","content":"`coaction/shared`"},"212":{"id":"/en/docs/concepts/store-modes-34","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#isolated-entry-points","content":"Shared-capable creation, the JSON protocol, authority and client mirrors"},"213":{"id":"/en/docs/concepts/store-modes-35","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#isolated-entry-points","content":"`coaction/adapter`"},"214":{"id":"/en/docs/concepts/store-modes-36","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#isolated-entry-points","content":"External-store binding and state/patch safety helpers"},"215":{"id":"/en/docs/concepts/store-modes-37","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#isolated-entry-points","content":"Framework packages expose their own `create()` wrapper and may support both local and worker\noptions. Vanilla code gets the clearest bundle boundary by choosing `coaction` or\n`coaction/shared` directly."},"216":{"id":"/en/docs/concepts/store-modes-38","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#three-things-the-word-sync-gets-used-for","content":"They compose, and none of them implies another:"},"217":{"id":"/en/docs/concepts/store-modes-39","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#three-things-the-word-sync-gets-used-for","content":"What it is"},"218":{"id":"/en/docs/concepts/store-modes-40","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#three-things-the-word-sync-gets-used-for","content":"**Reactive tracking**"},"219":{"id":"/en/docs/concepts/store-modes-41","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#three-things-the-word-sync-gets-used-for","content":"Which components re-render when a field changes — `observer`, selectors, computed getters."},"220":{"id":"/en/docs/concepts/store-modes-42","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#three-things-the-word-sync-gets-used-for","content":"**Shared authority**"},"221":{"id":"/en/docs/concepts/store-modes-43","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#three-things-the-word-sync-gets-used-for","content":"One store owns the state; other JavaScript contexts hold mirrors and call actions on it over a transport. This page."},"222":{"id":"/en/docs/concepts/store-modes-44","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#three-things-the-word-sync-gets-used-for","content":"**Remote synchronization**"},"223":{"id":"/en/docs/concepts/store-modes-45","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#three-things-the-word-sync-gets-used-for","content":"A durable outbox, a rebase against a server, offline recovery — `@coaction/sync`."},"224":{"id":"/en/docs/concepts/store-modes-46","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#three-things-the-word-sync-gets-used-for","content":"A local store can synchronize with a server without ever creating a Worker. And\na shared store's mirrors are views of one authority, not replicas that diverge\nand get merged — which is what the same vocabulary means in most other\nlibraries."},"225":{"id":"/en/docs/concepts/store-modes-47","page_id":"/en/docs/concepts/store-modes","tags":[],"type":"text","url":"/en/docs/concepts/store-modes#three-things-the-word-sync-gets-used-for","content":"Continue with the shared runtime overview for authority semantics and\ndeployment rules."},"226":{"id":"/en/docs/guides/from-zustand","page_id":"/en/docs/guides/from-zustand","type":"page","content":"Migrate from Zustand","breadcrumbs":["Coaction","Guides"],"tags":[],"url":"/en/docs/guides/from-zustand"},"227":{"id":"/en/docs/guides/from-zustand-0","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand","content":"Move an existing store incrementally while keeping selectors, middleware, and worker adoption deliberate."},"228":{"id":"/en/docs/guides/from-zustand-1","page_id":"/en/docs/guides/from-zustand","type":"heading","tags":[],"url":"/en/docs/guides/from-zustand#1-start-locally","content":"1\\. Start locally"},"229":{"id":"/en/docs/guides/from-zustand-2","page_id":"/en/docs/guides/from-zustand","type":"heading","tags":[],"url":"/en/docs/guides/from-zustand#2-keep-selectors-first","content":"2\\. Keep selectors first"},"230":{"id":"/en/docs/guides/from-zustand-3","page_id":"/en/docs/guides/from-zustand","type":"heading","tags":[],"url":"/en/docs/guides/from-zustand#3-move-repeated-derived-state-into-getters","content":"3\\. Move repeated derived state into getters"},"231":{"id":"/en/docs/guides/from-zustand-4","page_id":"/en/docs/guides/from-zustand","type":"heading","tags":[],"url":"/en/docs/guides/from-zustand#4-decide-whether-namespaced-slices-help","content":"4\\. Decide whether namespaced slices help"},"232":{"id":"/en/docs/guides/from-zustand-5","page_id":"/en/docs/guides/from-zustand","type":"heading","tags":[],"url":"/en/docs/guides/from-zustand#5-replace-middleware-separately","content":"5\\. Replace middleware separately"},"233":{"id":"/en/docs/guides/from-zustand-6","page_id":"/en/docs/guides/from-zustand","type":"heading","tags":[],"url":"/en/docs/guides/from-zustand#6-keep-zustand-underneath-when-that-is-safer","content":"6\\. Keep Zustand underneath when that is safer"},"234":{"id":"/en/docs/guides/from-zustand-7","page_id":"/en/docs/guides/from-zustand","type":"heading","tags":[],"url":"/en/docs/guides/from-zustand#7-add-shared-mode-last","content":"7\\. Add shared mode last"},"235":{"id":"/en/docs/guides/from-zustand-8","page_id":"/en/docs/guides/from-zustand","type":"heading","tags":[],"url":"/en/docs/guides/from-zustand#checklist","content":"Checklist"},"236":{"id":"/en/docs/guides/from-zustand-9","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand","content":"Coaction deliberately keeps a familiar `create()` shape, but a migration is more than changing\nan import. Move one behavior at a time and keep tests green between steps."},"237":{"id":"/en/docs/guides/from-zustand-10","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#1-start-locally","content":"Do not begin by moving the store into a worker. First reproduce the current local behavior:"},"238":{"id":"/en/docs/guides/from-zustand-11","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#1-start-locally","content":"Zustand updaters usually return a partial object. Coaction also accepts object merges, but its\nnative path is a draft callback inside `set()`."},"239":{"id":"/en/docs/guides/from-zustand-12","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#2-keep-selectors-first","content":"Existing selector-oriented components can keep the explicit style:"},"240":{"id":"/en/docs/guides/from-zustand-13","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#2-keep-selectors-first","content":"It reads like Zustand's, and does less work. The selector runs inside a reactive tracker, so the\npaths it reads become its dependencies and a write touching none of them does not re-run it --\nwhere Zustand runs every selector on every store notification and compares the result.\n`Object.is` still decides the re-render in both. A familiar and low-risk migration point either\nway."},"241":{"id":"/en/docs/guides/from-zustand-14","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#2-keep-selectors-first","content":"Once the store is stable, use `observer()` where automatic read tracking removes meaningful\nselector boilerplate:"},"242":{"id":"/en/docs/guides/from-zustand-15","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#3-move-repeated-derived-state-into-getters","content":"Accessor getters are cached. Use `get(deps, selector)` only when explicit dependencies make the\ncode clearer."},"243":{"id":"/en/docs/guides/from-zustand-16","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#4-decide-whether-namespaced-slices-help","content":"Zustand's common slice pattern spreads factories into one flat object. Coaction native slices\nare namespaced:"},"244":{"id":"/en/docs/guides/from-zustand-17","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#4-decide-whether-namespaced-slices-help","content":"Do not convert solely to preserve the word “slice.” Keep a single store when the flat shape is\nclearer."},"245":{"id":"/en/docs/guides/from-zustand-18","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#5-replace-middleware-separately","content":"Zustand concern"},"246":{"id":"/en/docs/guides/from-zustand-19","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#5-replace-middleware-separately","content":"Coaction path"},"247":{"id":"/en/docs/guides/from-zustand-20","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#5-replace-middleware-separately","content":"Immer update middleware"},"248":{"id":"/en/docs/guides/from-zustand-21","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#5-replace-middleware-separately","content":"Built-in draft updates through `set()`"},"249":{"id":"/en/docs/guides/from-zustand-22","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#5-replace-middleware-separately","content":"Persist"},"250":{"id":"/en/docs/guides/from-zustand-23","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#5-replace-middleware-separately","content":"`@coaction/persist` on the owning store"},"251":{"id":"/en/docs/guides/from-zustand-24","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#5-replace-middleware-separately","content":"Selector subscriptions"},"252":{"id":"/en/docs/guides/from-zustand-25","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#5-replace-middleware-separately","content":"Framework selectors or automatic tracking"},"253":{"id":"/en/docs/guides/from-zustand-26","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#5-replace-middleware-separately","content":"Existing external Zustand runtime"},"254":{"id":"/en/docs/guides/from-zustand-27","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#5-replace-middleware-separately","content":"`@coaction/zustand` whole-store adapter"},"255":{"id":"/en/docs/guides/from-zustand-28","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#5-replace-middleware-separately","content":"Custom external runtime"},"256":{"id":"/en/docs/guides/from-zustand-29","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#5-replace-middleware-separately","content":"`defineExternalStoreAdapter()` from `coaction/adapter`"},"257":{"id":"/en/docs/guides/from-zustand-30","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#5-replace-middleware-separately","content":"Coaction does not currently promise a Redux DevTools-compatible built-in experience. Keep\nproject-specific diagnostics or use logger until a maintained DevTools surface exists."},"258":{"id":"/en/docs/guides/from-zustand-31","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#6-keep-zustand-underneath-when-that-is-safer","content":"Use `@coaction/zustand` when the existing Zustand store is itself public API, other modules\ndepend on it directly, or replacing ownership would create more risk than value. The adapter is a\nwhole-store integration; it cannot live inside native Coaction slices."},"259":{"id":"/en/docs/guides/from-zustand-32","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#7-add-shared-mode-last","content":"After local tests pass, create the same source on a worker authority and connect a client.\nSwitch the `create` import to the shared entry; the default React entry rejects worker options:"},"260":{"id":"/en/docs/guides/from-zustand-33","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#7-add-shared-mode-last","content":"Audit the state against the strict JSON contract and change call sites to await actions. Direct\nclient `setState()` is not a supported migration shortcut."},"261":{"id":"/en/docs/guides/from-zustand-34","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#checklist","content":"Keep explicit selectors during the first behavior-preserving step."},"262":{"id":"/en/docs/guides/from-zustand-35","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#checklist","content":"Move writes into `set()` and keep the root schema stable."},"263":{"id":"/en/docs/guides/from-zustand-36","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#checklist","content":"Convert repeated derived selectors into cached getters selectively."},"264":{"id":"/en/docs/guides/from-zustand-37","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#checklist","content":"Choose namespaced slices only when they improve ownership."},"265":{"id":"/en/docs/guides/from-zustand-38","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#checklist","content":"Replace persistence/history/logging one at a time."},"266":{"id":"/en/docs/guides/from-zustand-39","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#checklist","content":"Keep the existing Zustand runtime through the adapter when appropriate."},"267":{"id":"/en/docs/guides/from-zustand-40","page_id":"/en/docs/guides/from-zustand","tags":[],"type":"text","url":"/en/docs/guides/from-zustand#checklist","content":"Introduce workers only after local behavior and serialization are verified."},"268":{"id":"/en/docs/guides/migrating-to-v4","page_id":"/en/docs/guides/migrating-to-v4","type":"page","content":"Migrating to 4.0","breadcrumbs":["Coaction","Guides"],"tags":[],"url":"/en/docs/guides/migrating-to-v4"},"269":{"id":"/en/docs/guides/migrating-to-v4-0","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4","content":"Update shared imports, check integration contracts, keep local React applications on supported versions, and check the Mutative 2 changes of 4.1 and the array element changes of 4.2."},"270":{"id":"/en/docs/guides/migrating-to-v4-1","page_id":"/en/docs/guides/migrating-to-v4","type":"heading","tags":[],"url":"/en/docs/guides/migrating-to-v4#select-the-owning-entry","content":"Select the owning entry"},"271":{"id":"/en/docs/guides/migrating-to-v4-2","page_id":"/en/docs/guides/migrating-to-v4","type":"heading","tags":[],"url":"/en/docs/guides/migrating-to-v4#check-low-level-writes-and-middleware","content":"Check low-level writes and middleware"},"272":{"id":"/en/docs/guides/migrating-to-v4-3","page_id":"/en/docs/guides/migrating-to-v4","type":"heading","tags":[],"url":"/en/docs/guides/migrating-to-v4#check-react-and-computed-assumptions","content":"Check React and computed assumptions"},"273":{"id":"/en/docs/guides/migrating-to-v4-4","page_id":"/en/docs/guides/migrating-to-v4","type":"heading","tags":[],"url":"/en/docs/guides/migrating-to-v4#check-remote-synchronization","content":"Check remote synchronization"},"274":{"id":"/en/docs/guides/migrating-to-v4-5","page_id":"/en/docs/guides/migrating-to-v4","type":"heading","tags":[],"url":"/en/docs/guides/migrating-to-v4#check-mutative-2-in-41","content":"Check Mutative 2 in 4.1"},"275":{"id":"/en/docs/guides/migrating-to-v4-6","page_id":"/en/docs/guides/migrating-to-v4","type":"heading","tags":[],"url":"/en/docs/guides/migrating-to-v4#check-array-elements-and-getinitialstate-in-42","content":"Check array elements and `getInitialState()` in 4.2"},"276":{"id":"/en/docs/guides/migrating-to-v4-7","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4","content":"Native local applications using actions, selectors and getters generally keep the same APIs.\nUse React 18 or 19, and check imports wherever state crosses a JavaScript context.\nThe repository migration guide\ncontains the extended adapter and local graph contracts."},"277":{"id":"/en/docs/guides/migrating-to-v4-8","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#select-the-owning-entry","content":"Usage"},"278":{"id":"/en/docs/guides/migrating-to-v4-9","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#select-the-owning-entry","content":"4.0 import"},"279":{"id":"/en/docs/guides/migrating-to-v4-10","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#select-the-owning-entry","content":"Vanilla local store"},"280":{"id":"/en/docs/guides/migrating-to-v4-11","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#select-the-owning-entry","content":"`coaction`"},"281":{"id":"/en/docs/guides/migrating-to-v4-12","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#select-the-owning-entry","content":"Vanilla shared authority or client"},"282":{"id":"/en/docs/guides/migrating-to-v4-13","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#select-the-owning-entry","content":"`coaction/shared`"},"283":{"id":"/en/docs/guides/migrating-to-v4-14","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#select-the-owning-entry","content":"React local store"},"284":{"id":"/en/docs/guides/migrating-to-v4-15","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#select-the-owning-entry","content":"`@coaction/react`"},"285":{"id":"/en/docs/guides/migrating-to-v4-16","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#select-the-owning-entry","content":"React shared authority or client"},"286":{"id":"/en/docs/guides/migrating-to-v4-17","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#select-the-owning-entry","content":"`@coaction/react/shared`"},"287":{"id":"/en/docs/guides/migrating-to-v4-18","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#select-the-owning-entry","content":"Integration and commit hooks"},"288":{"id":"/en/docs/guides/migrating-to-v4-19","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#select-the-owning-entry","content":"`coaction/adapter`"},"289":{"id":"/en/docs/guides/migrating-to-v4-20","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#select-the-owning-entry","content":"Managed derived selectors and paths"},"290":{"id":"/en/docs/guides/migrating-to-v4-21","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#select-the-owning-entry","content":"`coaction/derived`"},"291":{"id":"/en/docs/guides/migrating-to-v4-22","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#select-the-owning-entry","content":"The old `coaction/local` and `@coaction/react/local` aliases are gone. Shared stores that\npreviously used a default entry must switch to `/shared`:"},"292":{"id":"/en/docs/guides/migrating-to-v4-23","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#select-the-owning-entry","content":"The default entries reject non-null shared options such as `worker`, `transport` and\n`clientTransport`. An explicitly undefined option is accepted for feature detection and SSR.\nLocal imports exclude the shared transport runtime from the bundle."},"293":{"id":"/en/docs/guides/migrating-to-v4-24","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#check-low-level-writes-and-middleware","content":"Both `store.apply(nextState)` and `store.apply(base, patches)` publish commits. With patches,\nthe base must be current: omit it with `apply(undefined, patches)` or use `getPureState()`.\nA wrong base throws before changing state or publishing a commit."},"294":{"id":"/en/docs/guides/migrating-to-v4-25","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#check-low-level-writes-and-middleware","content":"Adapter authors must leave `store.apply` owned by Coaction and provide\n`internal.externalApply` for their runtime writer. Middleware should use\nStoreCommit hooks to observe all supported transitions,\nincluding writes that do not pass through `apply`."},"295":{"id":"/en/docs/guides/migrating-to-v4-26","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#check-low-level-writes-and-middleware","content":"Do not assume every patch pair contains leaf paths. Positional edits can fall back to\nreplacement patches at changed top-level keys; local object graphs can need a root snapshot\nat `path: []`. Replay must preserve the committed values and reference topology.\nLocal cycles are supported as complete values during initialization or replacement. Creating\ncycles from draft references and editing within cyclic drafts remain outside the recipe\ncontract. These local guarantees do not extend the shared JSON contract."},"296":{"id":"/en/docs/guides/migrating-to-v4-27","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#check-react-and-computed-assumptions","content":"React 18 and 19 are supported and tested. React 17 is outside the peer range.\nServer-side selectors read current state, consistent with whole-state and observer readers.\nUse `getInitialState()` explicitly if initial state is what the application needs, and create\nrequest-scoped stores with matching server and client hydration data."},"297":{"id":"/en/docs/guides/migrating-to-v4-28","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#check-react-and-computed-assumptions","content":"Native getters retain store/slice field dependencies. React selectors and `observer` use deep\npath tracking; `derive(..., { deep: true })` opts a managed computed selector into deep tracking.\nSee computed state for identity, lifecycle and invalidation boundaries."},"298":{"id":"/en/docs/guides/migrating-to-v4-29","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#check-remote-synchronization","content":"`@coaction/sync` requires durable storage and JSON state. Unsupported local writes are refused\nbefore committing. Checkpoints include `formatVersion`; unsupported versions and malformed\ncheckpoints are rejected without overwriting them. Legacy checkpoints without a version are\nread as format 1."},"299":{"id":"/en/docs/guides/migrating-to-v4-30","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#check-remote-synchronization","content":"Review the CRUD, Supabase and Firestore adapter READMEs when upgrading those integrations:\nthe CRUD adapter retains the remote base, Supabase applies the configured schema to reads and\nwrites, and Firestore separates its read source from its write address. See\nremote synchronization for configuration and failure handling."},"300":{"id":"/en/docs/guides/migrating-to-v4-31","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#check-remote-synchronization","content":"Reactive tracking, shared authority and remote synchronization are separate capabilities.\nA local store can sync to a server without a Worker. Shared mirrors follow one authority;\nthey do not independently diverge and merge like remote replicas."},"301":{"id":"/en/docs/guides/migrating-to-v4-32","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#check-mutative-2-in-41","content":"Coaction 4.1 depends on Mutative 2, and\n`@coaction/history` on Travels 3, which declares Mutative 2 as its peer. No Coaction API changed.\nUpgrade `mutative` too if the application imports it, and replace libraries that declare\nMutative 1 as their peer, such as `zustand-mutative` 1, because npm stops with `ERESOLVE` next\nto `@coaction/history`."},"302":{"id":"/en/docs/guides/migrating-to-v4-33","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#check-mutative-2-in-41","content":"Commit patches follow Mutative 2: nested patches come before their parents, and a moved draft\nis carried by the patches of its parent. They replay to the same state, so only tests that\ncompare patch arrays need new expectations. In production, errors from Mutative read\n`Minified Mutative error #<code>`; match the code, and define `process.env.NODE_ENV` in every\nbundle. The repository guide\ncovers loading without a bundler and the draft checks of development builds."},"303":{"id":"/en/docs/guides/migrating-to-v4-34","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#check-array-elements-and-getinitialstate-in-42","content":"Coaction 4.2 hands array elements out as frozen values instead of readonly proxies. A reader\ndepends on the identity of each element it reads, so an `observer()` rendering `todos[0].title`\nre-renders after any write inside `todos[0]`, and read-only array methods such as `filter` take\none dependency on the array, even when they stop early, as `find` and `at` do. Where a component renders more often than before, read the field or\nthe scan's result through a selector, which re-renders only when its result changes. Objects\nreached through object keys are tracked as before."},"304":{"id":"/en/docs/guides/migrating-to-v4-35","page_id":"/en/docs/guides/migrating-to-v4","tags":[],"type":"text","url":"/en/docs/guides/migrating-to-v4#check-array-elements-and-getinitialstate-in-42","content":"A write to an element outside `set()` throws the engine's `TypeError` in strict-mode code and is\nsilently ignored in sloppy-mode scripts, instead of throwing Coaction's direct-mutation error.\n`getInitialState()` returns a copy of the initial state shaped like the factory's object, the\nsame object on every call, rather than the factory's object itself. `@coaction/react` adds opt-in\nwhole selectors, `useStore(selector, { whole: true })`, whose selector receives the store's own\ndata and must never mutate it. An array's state is its elements: `create()` and `setState({ ... })`\nleave out its named keys and symbols, as a recipe's first write to it always did, and warn once in\ndevelopment, so keep such a value in an object beside the array. The\nrepository guide\ncompares each change with 4.1."},"305":{"id":"/en/docs/guides/performance","page_id":"/en/docs/guides/performance","type":"page","content":"Performance and bundle boundaries","breadcrumbs":["Coaction","Guides"],"tags":[],"url":"/en/docs/guides/performance"},"306":{"id":"/en/docs/guides/performance-0","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance","content":"Interpret Coaction benchmarks honestly and keep local applications on the transport-free entry point."},"307":{"id":"/en/docs/guides/performance-1","page_id":"/en/docs/guides/performance","type":"heading","tags":[],"url":"/en/docs/guides/performance#choose-the-local-entry-point","content":"Choose the local entry point"},"308":{"id":"/en/docs/guides/performance-2","page_id":"/en/docs/guides/performance","type":"heading","tags":[],"url":"/en/docs/guides/performance#run-the-maintained-checks","content":"Run the maintained checks"},"309":{"id":"/en/docs/guides/performance-3","page_id":"/en/docs/guides/performance","type":"heading","tags":[],"url":"/en/docs/guides/performance#understand-the-derived-state-tradeoff","content":"Understand the derived-state tradeoff"},"310":{"id":"/en/docs/guides/performance-4","page_id":"/en/docs/guides/performance","type":"heading","tags":[],"url":"/en/docs/guides/performance#render-performance","content":"Render performance"},"311":{"id":"/en/docs/guides/performance-5","page_id":"/en/docs/guides/performance","type":"heading","tags":[],"url":"/en/docs/guides/performance#practical-checklist","content":"Practical checklist"},"312":{"id":"/en/docs/guides/performance-6","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance","content":"Performance claims are useful only when the scenario, runtime, state shape, and package versions\nare visible. Coaction keeps its benchmark scripts in the repository so results can be regenerated\ninstead of treated as timeless numbers."},"313":{"id":"/en/docs/guides/performance-7","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#choose-the-local-entry-point","content":"For a vanilla local store:"},"314":{"id":"/en/docs/guides/performance-8","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#choose-the-local-entry-point","content":"This static boundary excludes shared protocol, epoch, reconnect, and transport modules from the\nentry. Use `coaction/shared` for the shared runtime, or `@coaction/react/shared` in React.\nThe default React entry, `@coaction/react`, also stays local."},"315":{"id":"/en/docs/guides/performance-9","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#choose-the-local-entry-point","content":"Bundle budgets in the repository measure published entries and tree-shaken consumer fixtures.\nThey are regression gates, not a promise that an application bundle equals the budget number;\nthe final result also depends on external dependencies retained by the application's bundler."},"316":{"id":"/en/docs/guides/performance-10","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#run-the-maintained-checks","content":"`package:size` checks published entry budgets and core entry isolation."},"317":{"id":"/en/docs/guides/performance-11","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#run-the-maintained-checks","content":"`benchmark` compares large update paths, including Coaction draft updates and Zustand + Immer."},"318":{"id":"/en/docs/guides/performance-12","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#run-the-maintained-checks","content":"`benchmark:zustand-positioning` separates stable derived reads from update-then-read work."},"319":{"id":"/en/docs/guides/performance-13","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#run-the-maintained-checks","content":"`benchmark:check` enforces regression floors with CI headroom."},"320":{"id":"/en/docs/guides/performance-14","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#run-the-maintained-checks","content":"`benchmark:derived` runs built-entry workloads in fresh processes: sparse paths,\nrelated/unrelated writes, full scans, cached reads, and unread/disposed owners.\nIt is included in `benchmark:check`; full deep scans are reported to make their\ntracking cost visible, while native getters provide the coarse scan baseline."},"321":{"id":"/en/docs/guides/performance-15","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#run-the-maintained-checks","content":"Thresholds must not be lowered merely to make a failing run green. A threshold change needs a\nreviewed runtime-semantic or benchmark-methodology reason."},"322":{"id":"/en/docs/guides/performance-16","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#understand-the-derived-state-tradeoff","content":"Cached accessors make repeated stable reads extremely cheap. After an update, Coaction still must\npreserve the readonly public-state boundary and update the snapshot used by computed traversal.\nThat makes “update then read a derived value” a different path from a stable cached read."},"323":{"id":"/en/docs/guides/performance-17","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#understand-the-derived-state-tradeoff","content":"Leave `enablePatches` unset unless an integration explicitly needs a journal. Commit hooks,\nshared transport and some tracking paths request patches automatically. Eligible small read\nsets can instead compare observed values before and after a write without generating patches;\ncached getter snapshots, patch middleware and larger dependency sets retain the patch path.\nOrdinary `subscribe()` listeners do not request patches themselves."},"324":{"id":"/en/docs/guides/performance-18","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#understand-the-derived-state-tradeoff","content":"Do not publish one of those cases as a universal “faster than Zustand” claim. Zustand can make a\nderived read constant-time by storing the derived value, but application actions must then keep it\nconsistent. Coaction's proposition is maintained cached derivation, not winning every mutation\nmicrobenchmark."},"325":{"id":"/en/docs/guides/performance-19","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#render-performance","content":"Both `useStore(selector)` and `observer()` use managed deep path tracking on native immutable\nstores. A reader of `state.user.name` can stay cached after an age-only recipe update. Selectors\nstill compare their results with `Object.is`; `observer()` collects reads during render without\nrequiring a selector. Measure selector executions and render counts separately."},"326":{"id":"/en/docs/guides/performance-20","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#render-performance","content":"Array elements are values: a reader depends on the identity of each element it reads, and array\nmethods such as `filter` and `map` take one dependency on the array. An `observer()` rendering\n`todos[0].title` re-renders after any write inside `todos[0]`, and one rendering a scan after a\nwrite to any element. A selector returning the field or the scan's result reruns, but re-renders\nonly when that result changes."},"327":{"id":"/en/docs/guides/performance-21","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#render-performance","content":"Native getters and `get(deps, fn)` retain the store/slice field boundary. A getter reading\n`this.user.name` can recompute when `user.age` changes, even if its result stays equal and its\nconsumers do no extra work. Use `derive(..., { deep: true })` or `derivePath` when a managed\nderived read needs finer dependencies."},"328":{"id":"/en/docs/guides/performance-22","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#render-performance","content":"Parent replacement, array structure changes and graph snapshot patches can invalidate more\nbroadly. External adapters follow their own update and snapshot contracts. See\ncomputed tracking granularity for the boundaries."},"329":{"id":"/en/docs/guides/performance-23","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#practical-checklist","content":"Import `coaction` for vanilla local-only state."},"330":{"id":"/en/docs/guides/performance-24","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#practical-checklist","content":"Leave `enablePatches` unset unless needed; account for consumers that request patches automatically."},"331":{"id":"/en/docs/guides/performance-25","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#practical-checklist","content":"Use cached getters for repeated derived reads, not side-effectful work."},"332":{"id":"/en/docs/guides/performance-26","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#practical-checklist","content":"Use `observer()` where it removes real selector composition."},"333":{"id":"/en/docs/guides/performance-27","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#practical-checklist","content":"Read a field of an array element, or the result of a scan, through a selector where an\n`observer()` would re-render for writes elsewhere in the elements."},"334":{"id":"/en/docs/guides/performance-28","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#practical-checklist","content":"Profile production builds and representative state, not development mode alone."},"335":{"id":"/en/docs/guides/performance-29","page_id":"/en/docs/guides/performance","tags":[],"type":"text","url":"/en/docs/guides/performance#practical-checklist","content":"Treat benchmark floors as regression detection and rerun publishable numbers on the target\nmachine."},"336":{"id":"/en/docs/guides/when-not-to-use","page_id":"/en/docs/guides/when-not-to-use","type":"page","content":"When not to use Coaction","breadcrumbs":["Coaction","Guides"],"tags":[],"url":"/en/docs/guides/when-not-to-use"},"337":{"id":"/en/docs/guides/when-not-to-use-0","page_id":"/en/docs/guides/when-not-to-use","tags":[],"type":"text","url":"/en/docs/guides/when-not-to-use","content":"An honest boundary check — the situations where Coaction is the wrong tool, and where it has no real competitor."},"338":{"id":"/en/docs/guides/when-not-to-use-1","page_id":"/en/docs/guides/when-not-to-use","type":"heading","tags":[],"url":"/en/docs/guides/when-not-to-use#skip-coaction-when","content":"Skip Coaction when"},"339":{"id":"/en/docs/guides/when-not-to-use-2","page_id":"/en/docs/guides/when-not-to-use","type":"heading","tags":[],"url":"/en/docs/guides/when-not-to-use#plain-single-tab-state-is-all-you-have","content":"Plain single-tab state is all you have"},"340":{"id":"/en/docs/guides/when-not-to-use-3","page_id":"/en/docs/guides/when-not-to-use","type":"heading","tags":[],"url":"/en/docs/guides/when-not-to-use#your-shared-state-is-not-json-shaped","content":"Your shared state is not JSON-shaped"},"341":{"id":"/en/docs/guides/when-not-to-use-4","page_id":"/en/docs/guides/when-not-to-use","type":"heading","tags":[],"url":"/en/docs/guides/when-not-to-use#call-sites-cannot-await-actions","content":"Call sites cannot await actions"},"342":{"id":"/en/docs/guides/when-not-to-use-5","page_id":"/en/docs/guides/when-not-to-use","type":"heading","tags":[],"url":"/en/docs/guides/when-not-to-use#your-measured-update-hot-path-misses-its-budget","content":"Your measured update hot path misses its budget"},"343":{"id":"/en/docs/guides/when-not-to-use-6","page_id":"/en/docs/guides/when-not-to-use","type":"heading","tags":[],"url":"/en/docs/guides/when-not-to-use#you-need-an-ecosystem-that-already-exists","content":"You need an ecosystem that already exists"},"344":{"id":"/en/docs/guides/when-not-to-use-7","page_id":"/en/docs/guides/when-not-to-use","type":"heading","tags":[],"url":"/en/docs/guides/when-not-to-use#your-browser-matrix-punishes-sharedworker","content":"Your browser matrix punishes SharedWorker"},"345":{"id":"/en/docs/guides/when-not-to-use-8","page_id":"/en/docs/guides/when-not-to-use","type":"heading","tags":[],"url":"/en/docs/guides/when-not-to-use#reach-for-coaction-when","content":"Reach for Coaction when"},"346":{"id":"/en/docs/guides/when-not-to-use-9","page_id":"/en/docs/guides/when-not-to-use","type":"heading","tags":[],"url":"/en/docs/guides/when-not-to-use#a-rule-of-thumb","content":"A rule of thumb"},"347":{"id":"/en/docs/guides/when-not-to-use-10","page_id":"/en/docs/guides/when-not-to-use","tags":[],"type":"text","url":"/en/docs/guides/when-not-to-use","content":"Most apps do not need Coaction. A Zustand or Jotai store plus a few selectors is a smaller,\nsafer dependency for plain client state, and \"more powerful\" is not a reason to pay switching\ncosts. This page exists so you can make that call quickly, and so the cases where Coaction\ngenuinely has no equivalent are easy to find."},"348":{"id":"/en/docs/guides/when-not-to-use-11","page_id":"/en/docs/guides/when-not-to-use","tags":[],"type":"text","url":"/en/docs/guides/when-not-to-use","content":"This guide is deliberately anti-marketing. If your situation is listed under \"skip it\", skip it —\nthe Coaction you would need is not the Coaction being offered."},"349":{"id":"/en/docs/guides/when-not-to-use-12","page_id":"/en/docs/guides/when-not-to-use","tags":[],"type":"text","url":"/en/docs/guides/when-not-to-use#plain-single-tab-state-is-all-you-have","content":"A form here, a counter there, one settings panel. Coaction's readonly state and reactive runtime\nmay cost more than those needs justify. The default `coaction` and `@coaction/react` entries\nexclude the shared transport runtime; using a local store does not bundle an inactive transport.\n**Consider Zustand, Jotai, or component state** when their smaller model covers the problem.\nCoaction's local runtime becomes useful when shared derivation or read tracking removes\nsubstantial application code, even if the application never needs a Worker."},"350":{"id":"/en/docs/guides/when-not-to-use-13","page_id":"/en/docs/guides/when-not-to-use","tags":[],"type":"text","url":"/en/docs/guides/when-not-to-use#your-shared-state-is-not-json-shaped","content":"Everything crossing a shared boundary — state, action arguments, returned values — must be a\nplain JSON tree: no `Date`, no `Map`, no class instances, no `undefined`, no cycles. Domain\nmodels built from rich objects need a serialization redesign before they can be shared, and\nthat redesign is the real cost, not the store call. Keep such state local, or accept the mapping\nlayer. See the JSON contract for the exact rules."},"351":{"id":"/en/docs/guides/when-not-to-use-14","page_id":"/en/docs/guides/when-not-to-use","tags":[],"type":"text","url":"/en/docs/guides/when-not-to-use#call-sites-cannot-await-actions","content":"Client-mirror actions execute on the authority and return promises. UI that must read a result\nsynchronously — optimistic-free flows, render-phase reads of action results, hot paths where a\nround-trip is a regression — should keep authority local instead of forcing every read through\na transport."},"352":{"id":"/en/docs/guides/when-not-to-use-15","page_id":"/en/docs/guides/when-not-to-use","tags":[],"type":"text","url":"/en/docs/guides/when-not-to-use#your-measured-update-hot-path-misses-its-budget","content":"Do not infer a universal write penalty from one microbenchmark. In the measured 4.0 scenario that\nupdates one item and then reads a derived total across 1,000 items, Coaction reaches about 55% of the\nthroughput of the equivalent Zustand selector case and is far behind a hand-maintained field. A\nseparate bulk benchmark shows that other update shapes can be comparable or favor Mutative. For\nhigh-frequency drag, animation frames, and streaming tick handlers, benchmark the representative\noperation and skip Coaction when it misses the required budget."},"353":{"id":"/en/docs/guides/when-not-to-use-16","page_id":"/en/docs/guides/when-not-to-use","tags":[],"type":"text","url":"/en/docs/guides/when-not-to-use#you-need-an-ecosystem-that-already-exists","content":"Mature devtools, a large middleware shelf, community answers on every edge case. Coaction is a\nfocused project, not an ecosystem. Check the support matrix\nbefore betting a large surface on it."},"354":{"id":"/en/docs/guides/when-not-to-use-17","page_id":"/en/docs/guides/when-not-to-use","tags":[],"type":"text","url":"/en/docs/guides/when-not-to-use#your-browser-matrix-punishes-sharedworker","content":"Module SharedWorkers are inconsistent across browsers and private modes. If every tab must share\none state instance, treat missing `SharedWorker` as a hard failure rather than shipping the\nlocal fallback and hoping. Cross-tab state that merely\nneeds to *eventually* agree often fits `BroadcastChannel` + persistence — simpler machinery,\nweaker guarantees."},"355":{"id":"/en/docs/guides/when-not-to-use-18","page_id":"/en/docs/guides/when-not-to-use","tags":[],"type":"text","url":"/en/docs/guides/when-not-to-use#reach-for-coaction-when","content":"**One state, many tabs.** A SharedWorker authority with mirrored clients — the\ncross-tab todos demo\nreplays a full editing session across tabs on three engines."},"356":{"id":"/en/docs/guides/when-not-to-use-19","page_id":"/en/docs/guides/when-not-to-use","tags":[],"type":"text","url":"/en/docs/guides/when-not-to-use#reach-for-coaction-when","content":"**Heavy compute off the main thread.** Keep the write authority in a Web Worker; the main\nthread keeps synchronous local reads from its mirror."},"357":{"id":"/en/docs/guides/when-not-to-use-20","page_id":"/en/docs/guides/when-not-to-use","tags":[],"type":"text","url":"/en/docs/guides/when-not-to-use#reach-for-coaction-when","content":"**You want signals ergonomics without leaving the `create()` world.** Render tracking and\ncached computed values with Zustand-style stores."},"358":{"id":"/en/docs/guides/when-not-to-use-21","page_id":"/en/docs/guides/when-not-to-use","tags":[],"type":"text","url":"/en/docs/guides/when-not-to-use#reach-for-coaction-when","content":"**Gradual adoption matters.** The Zustand adapter wraps an\nexisting store first; workers and cross-tab mode can come later without rewriting call sites."},"359":{"id":"/en/docs/guides/when-not-to-use-22","page_id":"/en/docs/guides/when-not-to-use","tags":[],"type":"text","url":"/en/docs/guides/when-not-to-use#reach-for-coaction-when","content":"**Real-time collaboration.** The Yjs binding puts CRDT state behind\nthe same store interface."},"360":{"id":"/en/docs/guides/when-not-to-use-23","page_id":"/en/docs/guides/when-not-to-use","tags":[],"type":"text","url":"/en/docs/guides/when-not-to-use#a-rule-of-thumb","content":"> Adopt Coaction when the *shape of your problem* is more than one thread, more than one tab, or\n> more derivation than you want to memoize by hand. Adopt something smaller when it is not."},"361":{"id":"/en/docs/integrations/adapters","page_id":"/en/docs/integrations/adapters","type":"page","content":"External state adapters","breadcrumbs":["Coaction","Integrations"],"tags":[],"url":"/en/docs/integrations/adapters"},"362":{"id":"/en/docs/integrations/adapters-0","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters","content":"Keep an existing Zustand, MobX, Pinia, Jotai, Redux, Valtio, or XState runtime as a whole-store integration."},"363":{"id":"/en/docs/integrations/adapters-1","page_id":"/en/docs/integrations/adapters","type":"heading","tags":[],"url":"/en/docs/integrations/adapters#support-matrix","content":"Support matrix"},"364":{"id":"/en/docs/integrations/adapters-2","page_id":"/en/docs/integrations/adapters","type":"heading","tags":[],"url":"/en/docs/integrations/adapters#zustand-example","content":"Zustand example"},"365":{"id":"/en/docs/integrations/adapters-3","page_id":"/en/docs/integrations/adapters","type":"heading","tags":[],"url":"/en/docs/integrations/adapters#mobx-example","content":"MobX example"},"366":{"id":"/en/docs/integrations/adapters-4","page_id":"/en/docs/integrations/adapters","type":"heading","tags":[],"url":"/en/docs/integrations/adapters#pinia-jotai-redux-valtio-and-xstate","content":"Pinia, Jotai, Redux, Valtio, and XState"},"367":{"id":"/en/docs/integrations/adapters-5","page_id":"/en/docs/integrations/adapters","type":"heading","tags":[],"url":"/en/docs/integrations/adapters#authoring-an-adapter","content":"Authoring an adapter"},"368":{"id":"/en/docs/integrations/adapters-6","page_id":"/en/docs/integrations/adapters","type":"heading","tags":[],"url":"/en/docs/integrations/adapters#the-write-boundary","content":"The write boundary"},"369":{"id":"/en/docs/integrations/adapters-7","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters","content":"An external-state adapter bridges a complete third-party runtime into Coaction. The external\nruntime keeps its native mutation and derived-state semantics; Coaction supplies its store,\nframework, lifecycle, and—for supported adapters—shared method-execution surface."},"370":{"id":"/en/docs/integrations/adapters-8","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters","content":"Binder-backed adapters are not native slices. Never mount an adapted external\nstore below a Coaction slice key."},"371":{"id":"/en/docs/integrations/adapters-9","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Adapter"},"372":{"id":"/en/docs/integrations/adapters-10","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Package"},"373":{"id":"/en/docs/integrations/adapters-11","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Local"},"374":{"id":"/en/docs/integrations/adapters-12","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Shared main/client"},"375":{"id":"/en/docs/integrations/adapters-13","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Direct client writes"},"376":{"id":"/en/docs/integrations/adapters-14","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Zustand"},"377":{"id":"/en/docs/integrations/adapters-15","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"`@coaction/zustand`"},"378":{"id":"/en/docs/integrations/adapters-16","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Supported"},"379":{"id":"/en/docs/integrations/adapters-17","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Supported"},"380":{"id":"/en/docs/integrations/adapters-18","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Rejected"},"381":{"id":"/en/docs/integrations/adapters-19","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"MobX"},"382":{"id":"/en/docs/integrations/adapters-20","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"`@coaction/mobx`"},"383":{"id":"/en/docs/integrations/adapters-21","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Supported"},"384":{"id":"/en/docs/integrations/adapters-22","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Supported"},"385":{"id":"/en/docs/integrations/adapters-23","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Integration-defined"},"386":{"id":"/en/docs/integrations/adapters-24","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Pinia"},"387":{"id":"/en/docs/integrations/adapters-25","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"`@coaction/pinia`"},"388":{"id":"/en/docs/integrations/adapters-26","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Supported"},"389":{"id":"/en/docs/integrations/adapters-27","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Supported"},"390":{"id":"/en/docs/integrations/adapters-28","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Integration-defined"},"391":{"id":"/en/docs/integrations/adapters-29","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Jotai"},"392":{"id":"/en/docs/integrations/adapters-30","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"`@coaction/jotai`"},"393":{"id":"/en/docs/integrations/adapters-31","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Supported"},"394":{"id":"/en/docs/integrations/adapters-32","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Supported"},"395":{"id":"/en/docs/integrations/adapters-33","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Rejected"},"396":{"id":"/en/docs/integrations/adapters-34","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Redux Toolkit"},"397":{"id":"/en/docs/integrations/adapters-35","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"`@coaction/redux`"},"398":{"id":"/en/docs/integrations/adapters-36","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Supported"},"399":{"id":"/en/docs/integrations/adapters-37","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Unsupported"},"400":{"id":"/en/docs/integrations/adapters-38","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"N/A"},"401":{"id":"/en/docs/integrations/adapters-39","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Valtio"},"402":{"id":"/en/docs/integrations/adapters-40","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"`@coaction/valtio`"},"403":{"id":"/en/docs/integrations/adapters-41","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Supported"},"404":{"id":"/en/docs/integrations/adapters-42","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Supported"},"405":{"id":"/en/docs/integrations/adapters-43","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Restored to authority snapshot"},"406":{"id":"/en/docs/integrations/adapters-44","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"XState"},"407":{"id":"/en/docs/integrations/adapters-45","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"`@coaction/xstate`"},"408":{"id":"/en/docs/integrations/adapters-46","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Supported"},"409":{"id":"/en/docs/integrations/adapters-47","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Unsupported"},"410":{"id":"/en/docs/integrations/adapters-48","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"N/A"},"411":{"id":"/en/docs/integrations/adapters-49","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#support-matrix","content":"Shared support means Coaction method execution is maintained. It does not promise that arbitrary\nout-of-band writes to every external runtime propagate across authority and client."},"412":{"id":"/en/docs/integrations/adapters-50","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#zustand-example","content":"Use this path when the Zustand store must remain public API or other modules still consume it\ndirectly. For a new store owned by Coaction, prefer the native state model."},"413":{"id":"/en/docs/integrations/adapters-51","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#mobx-example","content":"The external runtime owns its mutable object. Unknown root properties written directly onto a\nmutable adapter are not promoted into Coaction's fixed raw/public schema."},"414":{"id":"/en/docs/integrations/adapters-52","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#pinia-jotai-redux-valtio-and-xstate","content":"These packages expose `bind*` helpers and, where needed, an `adapt()` wrapper:"},"415":{"id":"/en/docs/integrations/adapters-53","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#pinia-jotai-redux-valtio-and-xstate","content":"XState blocks `setState()`; send actor events. Redux and XState are local-only maintained\ncontracts today."},"416":{"id":"/en/docs/integrations/adapters-54","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#authoring-an-adapter","content":"Custom adapters import `defineExternalStoreAdapter()` from `coaction/adapter`. They must preserve\nthe core `Store` lifecycle, notify Coaction after direct external immutable writes, and declare\nsupport boundaries with contract tests. See contributing before\nstarting one."},"417":{"id":"/en/docs/integrations/adapters-55","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#the-write-boundary","content":"`store.apply` belongs to Coaction. An adapter says how to write a change into\nits own runtime by setting `internal.externalApply`, and that is the whole of\nits job here — Coaction works out the patch pair, runs commit validators, calls\nthe writer, and publishes the commit."},"418":{"id":"/en/docs/integrations/adapters-56","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#the-write-boundary","content":"An adapter that only wants to refuse a direct write, because its runtime takes\nchanges through its own channel, needs no writer at all — refuse from\n`internal.assertMutationAllowed` and let the ordinary `apply` do the work."},"419":{"id":"/en/docs/integrations/adapters-57","page_id":"/en/docs/integrations/adapters","tags":[],"type":"text","url":"/en/docs/integrations/adapters#the-write-boundary","content":"Adapters used to replace `store.apply` outright. That took on commit semantics\nthey did not want, and discarded anything middleware had wrapped `apply` with,\nsince middleware runs first."},"420":{"id":"/en/docs/integrations/frameworks","page_id":"/en/docs/integrations/frameworks","type":"page","content":"Framework integrations","breadcrumbs":["Coaction","Integrations"],"tags":[],"url":"/en/docs/integrations/frameworks"},"421":{"id":"/en/docs/integrations/frameworks-0","page_id":"/en/docs/integrations/frameworks","tags":[],"type":"text","url":"/en/docs/integrations/frameworks","content":"Connect one Coaction store model to React, Vue, Angular, Svelte, or Solid."},"422":{"id":"/en/docs/integrations/frameworks-1","page_id":"/en/docs/integrations/frameworks","type":"heading","tags":[],"url":"/en/docs/integrations/frameworks#react","content":"React"},"423":{"id":"/en/docs/integrations/frameworks-2","page_id":"/en/docs/integrations/frameworks","type":"heading","tags":[],"url":"/en/docs/integrations/frameworks#whole-selectors","content":"Whole selectors"},"424":{"id":"/en/docs/integrations/frameworks-3","page_id":"/en/docs/integrations/frameworks","type":"heading","tags":[],"url":"/en/docs/integrations/frameworks#server-rendering","content":"Server rendering"},"425":{"id":"/en/docs/integrations/frameworks-4","page_id":"/en/docs/integrations/frameworks","type":"heading","tags":[],"url":"/en/docs/integrations/frameworks#vue","content":"Vue"},"426":{"id":"/en/docs/integrations/frameworks-5","page_id":"/en/docs/integrations/frameworks","type":"heading","tags":[],"url":"/en/docs/integrations/frameworks#angular","content":"Angular"},"427":{"id":"/en/docs/integrations/frameworks-6","page_id":"/en/docs/integrations/frameworks","type":"heading","tags":[],"url":"/en/docs/integrations/frameworks#svelte","content":"Svelte"},"428":{"id":"/en/docs/integrations/frameworks-7","page_id":"/en/docs/integrations/frameworks","type":"heading","tags":[],"url":"/en/docs/integrations/frameworks#solid","content":"Solid"},"429":{"id":"/en/docs/integrations/frameworks-8","page_id":"/en/docs/integrations/frameworks","type":"heading","tags":[],"url":"/en/docs/integrations/frameworks#shared-mode-note","content":"Shared-mode note"},"430":{"id":"/en/docs/integrations/frameworks-9","page_id":"/en/docs/integrations/frameworks","tags":[],"type":"text","url":"/en/docs/integrations/frameworks","content":"Framework packages wrap the core `Store` contract with the reactive primitive native to each\necosystem. State creation, actions, computed getters, slices, and shared-mode rules remain core\nbehavior."},"431":{"id":"/en/docs/integrations/frameworks-10","page_id":"/en/docs/integrations/frameworks","tags":[],"type":"text","url":"/en/docs/integrations/frameworks#react","content":"`@coaction/react` supports React 18 and 19. Both are covered by CI, which\ninstalls each and runs the suite against it."},"432":{"id":"/en/docs/integrations/frameworks-11","page_id":"/en/docs/integrations/frameworks","tags":[],"type":"text","url":"/en/docs/integrations/frameworks#react","content":"Inside `observer()`, a no-selector hook call tracks fields read during render. Outside\n`observer()`, it is a whole-store subscription. Use an explicit selector when that intent is\nclearer:"},"433":{"id":"/en/docs/integrations/frameworks-12","page_id":"/en/docs/integrations/frameworks","tags":[],"type":"text","url":"/en/docs/integrations/frameworks#react","content":"`<Observer>` creates a smaller tracked render region, and `useCounter.auto()` returns a cached\nfield-selector map."},"434":{"id":"/en/docs/integrations/frameworks-13","page_id":"/en/docs/integrations/frameworks","tags":[],"type":"text","url":"/en/docs/integrations/frameworks#whole-selectors","content":"A selector that scans most of the state anyway gains little from tracking each read. Pass\n`{ whole: true }` to run it over the store's plain data instead:"},"435":{"id":"/en/docs/integrations/frameworks-14","page_id":"/en/docs/integrations/frameworks","tags":[],"type":"text","url":"/en/docs/integrations/frameworks#whole-selectors","content":"A whole selector receives `getPureState()`: the store's own data as plain objects, without getters\nor methods. It records no dependencies, runs again on every commit, and re-renders the component\nonly when the result changes by `Object.is`, or by the `equals` you pass. While no tracked selector\nor `observer()` reads a store, its writes skip the patch bookkeeping that tracking needs."},"436":{"id":"/en/docs/integrations/frameworks-15","page_id":"/en/docs/integrations/frameworks","tags":[],"type":"text","url":"/en/docs/integrations/frameworks#whole-selectors","content":"The selector is handed the store's own data: read it, never mutate it. Keep each hook call in one\nmode, since switching a call between `{ whole: true }` and a tracked selector changes the hooks it\nruns."},"437":{"id":"/en/docs/integrations/frameworks-16","page_id":"/en/docs/integrations/frameworks","tags":[],"type":"text","url":"/en/docs/integrations/frameworks#server-rendering","content":"On a server there is nothing to subscribe to, so every way of reading a store is\na plain read of the state as it is at that moment — a selector, a no-selector\ncall, and `observer` all agree."},"438":{"id":"/en/docs/integrations/frameworks-17","page_id":"/en/docs/integrations/frameworks","tags":[],"type":"text","url":"/en/docs/integrations/frameworks#server-rendering","content":"That matters when something has written to the store before rendering: a request\npreloading data, a hydration middleware, an initialisation second phase. All\nthree report the value that was written, which is also what the client hydrates\nagainst, so React accepts the markup instead of reporting a mismatch and\nre-rendering the tree."},"439":{"id":"/en/docs/integrations/frameworks-18","page_id":"/en/docs/integrations/frameworks","tags":[],"type":"text","url":"/en/docs/integrations/frameworks#server-rendering","content":"If you want the value the store was created with, ask for it:"},"440":{"id":"/en/docs/integrations/frameworks-19","page_id":"/en/docs/integrations/frameworks","tags":[],"type":"text","url":"/en/docs/integrations/frameworks#vue","content":"`useCounter({ autoSelector: true })` returns computed refs for known fields. Call methods directly\nand read data refs through `.value`."},"441":{"id":"/en/docs/integrations/frameworks-20","page_id":"/en/docs/integrations/frameworks","tags":[],"type":"text","url":"/en/docs/integrations/frameworks#angular","content":"`select()` returns an Angular signal-like accessor for the selector result."},"442":{"id":"/en/docs/integrations/frameworks-21","page_id":"/en/docs/integrations/frameworks","tags":[],"type":"text","url":"/en/docs/integrations/frameworks#svelte","content":"The selector call returns a readable Svelte store."},"443":{"id":"/en/docs/integrations/frameworks-22","page_id":"/en/docs/integrations/frameworks","tags":[],"type":"text","url":"/en/docs/integrations/frameworks#solid","content":"The selector result is a Solid accessor."},"444":{"id":"/en/docs/integrations/frameworks-23","page_id":"/en/docs/integrations/frameworks","tags":[],"type":"text","url":"/en/docs/integrations/frameworks#shared-mode-note","content":"Framework packages can wrap a client mirror. Store methods then return promises even if the same\nmethod is synchronous in a local store. Await mutations when the store is created with a Worker\nor SharedWorker."},"445":{"id":"/en/docs/integrations/frameworks-24","page_id":"/en/docs/integrations/frameworks","tags":[],"type":"text","url":"/en/docs/integrations/frameworks#shared-mode-note","content":"Generated selector maps are based on the schema known during initialization. Dynamic paths\ninside a declared record should use an explicit selector rather than expecting an auto-selector\nmap to grow."},"446":{"id":"/en/docs/integrations/middleware","page_id":"/en/docs/integrations/middleware","type":"page","content":"Logger, persist, and history","breadcrumbs":["Coaction","Integrations"],"tags":[],"url":"/en/docs/integrations/middleware"},"447":{"id":"/en/docs/integrations/middleware-0","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware","content":"Add diagnostics, persistence, and undo/redo to a Coaction-owned store through middleware."},"448":{"id":"/en/docs/integrations/middleware-1","page_id":"/en/docs/integrations/middleware","type":"heading","tags":[],"url":"/en/docs/integrations/middleware#logger","content":"Logger"},"449":{"id":"/en/docs/integrations/middleware-2","page_id":"/en/docs/integrations/middleware","type":"heading","tags":[],"url":"/en/docs/integrations/middleware#persist","content":"Persist"},"450":{"id":"/en/docs/integrations/middleware-3","page_id":"/en/docs/integrations/middleware","type":"heading","tags":[],"url":"/en/docs/integrations/middleware#history","content":"History"},"451":{"id":"/en/docs/integrations/middleware-4","page_id":"/en/docs/integrations/middleware","type":"heading","tags":[],"url":"/en/docs/integrations/middleware#shared-placement","content":"Shared placement"},"452":{"id":"/en/docs/integrations/middleware-5","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware","content":"Middleware receives the store during creation and may decorate its methods or attach an API. Pass\nmiddleware in array order through the plural `middlewares` option."},"453":{"id":"/en/docs/integrations/middleware-6","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#logger","content":"You may inject a console-compatible logger. Serialized mode safely handles circular diagnostic\nvalues and BigInt; logging does not weaken the shared JSON contract."},"454":{"id":"/en/docs/integrations/middleware-7","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#logger","content":"Install logger on the authority for authority-side action and patch diagnostics. A client logger\nis limited to mirrored updates and proxied calls."},"455":{"id":"/en/docs/integrations/middleware-8","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#persist","content":"The default storage is `localStorage` when available. `createJSONStorage()` adapts another Web\nStorage instance, and a custom `PersistStorage` may be synchronous or asynchronous."},"456":{"id":"/en/docs/integrations/middleware-9","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#persist","content":"`persist()` attaches:"},"457":{"id":"/en/docs/integrations/middleware-10","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#persist","content":"If a payload contains an explicit version that differs from the configured version, provide\n`migrate`. Without it, hydration is skipped and `onRehydrateStorage` receives the error."},"458":{"id":"/en/docs/integrations/middleware-11","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#persist","content":"`merge` output still obeys the fixed schema: unknown root keys are rejected."},"459":{"id":"/en/docs/integrations/middleware-12","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#history","content":"`partialize` limits which state participates in time travel. `limit` must be a non-negative\ninteger."},"460":{"id":"/en/docs/integrations/middleware-13","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#shared-placement","content":"Middleware"},"461":{"id":"/en/docs/integrations/middleware-14","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#shared-placement","content":"Local"},"462":{"id":"/en/docs/integrations/middleware-15","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#shared-placement","content":"Shared main"},"463":{"id":"/en/docs/integrations/middleware-16","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#shared-placement","content":"Shared client"},"464":{"id":"/en/docs/integrations/middleware-17","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#shared-placement","content":"Logger"},"465":{"id":"/en/docs/integrations/middleware-18","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#shared-placement","content":"Supported"},"466":{"id":"/en/docs/integrations/middleware-19","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#shared-placement","content":"Supported"},"467":{"id":"/en/docs/integrations/middleware-20","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#shared-placement","content":"Limited visibility"},"468":{"id":"/en/docs/integrations/middleware-21","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#shared-placement","content":"Persist"},"469":{"id":"/en/docs/integrations/middleware-22","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#shared-placement","content":"Supported"},"470":{"id":"/en/docs/integrations/middleware-23","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#shared-placement","content":"Supported"},"471":{"id":"/en/docs/integrations/middleware-24","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#shared-placement","content":"Rejected"},"472":{"id":"/en/docs/integrations/middleware-25","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#shared-placement","content":"History"},"473":{"id":"/en/docs/integrations/middleware-26","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#shared-placement","content":"Supported"},"474":{"id":"/en/docs/integrations/middleware-27","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#shared-placement","content":"Supported"},"475":{"id":"/en/docs/integrations/middleware-28","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#shared-placement","content":"Rejected"},"476":{"id":"/en/docs/integrations/middleware-29","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#shared-placement","content":"Persistence and time travel are writes. Put them on the authority store so every client observes\none result. Never present client-local persistence or undo as authoritative state."},"477":{"id":"/en/docs/integrations/middleware-30","page_id":"/en/docs/integrations/middleware","tags":[],"type":"text","url":"/en/docs/integrations/middleware#shared-placement","content":"`persist` and `history` coordinate so hydration does not create misleading undo entries."},"478":{"id":"/en/docs/integrations/sync","page_id":"/en/docs/integrations/sync","type":"page","content":"Local-first sync","breadcrumbs":["Coaction","Integrations"],"tags":[],"url":"/en/docs/integrations/sync"},"479":{"id":"/en/docs/integrations/sync-0","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync","content":"Keep a Coaction store working offline and converging with a server, through a durable outbox and a rebase."},"480":{"id":"/en/docs/integrations/sync-1","page_id":"/en/docs/integrations/sync","type":"heading","tags":[],"url":"/en/docs/integrations/sync#reading-the-queue","content":"Reading the queue"},"481":{"id":"/en/docs/integrations/sync-2","page_id":"/en/docs/integrations/sync","type":"heading","tags":[],"url":"/en/docs/integrations/sync#backends","content":"Backends"},"482":{"id":"/en/docs/integrations/sync-3","page_id":"/en/docs/integrations/sync","type":"heading","tags":[],"url":"/en/docs/integrations/sync#conflicts","content":"Conflicts"},"483":{"id":"/en/docs/integrations/sync-4","page_id":"/en/docs/integrations/sync","type":"heading","tags":[],"url":"/en/docs/integrations/sync#state-has-to-be-json","content":"State has to be JSON"},"484":{"id":"/en/docs/integrations/sync-5","page_id":"/en/docs/integrations/sync","type":"heading","tags":[],"url":"/en/docs/integrations/sync#storage","content":"Storage"},"485":{"id":"/en/docs/integrations/sync-6","page_id":"/en/docs/integrations/sync","type":"heading","tags":[],"url":"/en/docs/integrations/sync#delivery","content":"Delivery"},"486":{"id":"/en/docs/integrations/sync-7","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync","content":"`@coaction/sync` is middleware. The store stays an ordinary Coaction store —\nactions, selectors, `observer`, history — and every commit it makes is also\nqueued for a server."},"487":{"id":"/en/docs/integrations/sync-8","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync","content":"A write lands locally at once. It is written to a durable outbox before anything\nis sent, so a crash between the write and the delivery is recoverable, and a\npull rebases whatever is still pending over what the server sent."},"488":{"id":"/en/docs/integrations/sync-9","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync","content":"This is not shared authority. A synced store owns\nits state and reconciles with a remote; a shared store's mirrors are views of\none authority in another JavaScript context. They compose, and neither implies\nthe other."},"489":{"id":"/en/docs/integrations/sync-10","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#reading-the-queue","content":"`getPending()` hands back copies. The queue is what the client owes the server\nand the rebase reads it back as its own working set, so nothing outside can edit\nit by accident."},"490":{"id":"/en/docs/integrations/sync-11","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#backends","content":"Import"},"491":{"id":"/en/docs/integrations/sync-12","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#backends","content":"Backend"},"492":{"id":"/en/docs/integrations/sync-13","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#backends","content":"`@coaction/sync`"},"493":{"id":"/en/docs/integrations/sync-14","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#backends","content":"`createFetchSyncAdapter` — JSON over HTTP"},"494":{"id":"/en/docs/integrations/sync-15","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#backends","content":"`@coaction/sync/crud`"},"495":{"id":"/en/docs/integrations/sync-16","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#backends","content":"`createCrudSyncAdapter` — a record-shaped API"},"496":{"id":"/en/docs/integrations/sync-17","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#backends","content":"`@coaction/sync/supabase`"},"497":{"id":"/en/docs/integrations/sync-18","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#backends","content":"a Postgres table, with an optional changes-since cursor and realtime"},"498":{"id":"/en/docs/integrations/sync-19","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#backends","content":"`@coaction/sync/firestore`"},"499":{"id":"/en/docs/integrations/sync-20","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#backends","content":"a Firestore collection or query, with optional `onSnapshot`"},"500":{"id":"/en/docs/integrations/sync-21","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#backends","content":"`@coaction/sync/query`"},"501":{"id":"/en/docs/integrations/sync-22","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#backends","content":"TanStack Query"},"502":{"id":"/en/docs/integrations/sync-23","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#backends","content":"An adapter is two functions, so a backend not listed here is a `pull` and a\n`push`:"},"503":{"id":"/en/docs/integrations/sync-24","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#backends","content":"`push` returns the ids the remote durably accepted. Anything it does not\nacknowledge stays queued and is retried."},"504":{"id":"/en/docs/integrations/sync-25","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#conflicts","content":"When a pull brings a change that overlaps something still pending, the default\nkeeps the local write. `conflict: 'remote-wins'` keeps the remote one, and a\nfunction decides per mutation:"},"505":{"id":"/en/docs/integrations/sync-26","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#conflicts","content":"Each call is given its own copy of everything, so a resolver that works on what\nit is handed cannot disturb the rebase or the next call."},"506":{"id":"/en/docs/integrations/sync-27","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#state-has-to-be-json","content":"The outbox, the optimistic snapshot and the adapter's view of the remote are all\nstored as JSON, so state JSON cannot represent is not persisted — it is quietly\nchanged. A `Date` comes back a string; a `Map` comes back `{}`."},"507":{"id":"/en/docs/integrations/sync-28","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#state-has-to-be-json","content":"A write that introduces one is refused **before it is committed**, so the error\nreaches the caller and the store keeps state it can carry. Keep dates as ISO\nstrings or epoch numbers, keyed collections as records, and sets as arrays."},"508":{"id":"/en/docs/integrations/sync-29","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#state-has-to-be-json","content":"`sync()` does not attach to an external mutable adapter — MobX, Valtio and Pinia\nexpose accessor-backed state, which this contract refuses when the store is\nbuilt."},"509":{"id":"/en/docs/integrations/sync-30","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#storage","content":"Defaults to `localStorage`. Pass a `storage`, or\n`@coaction/sync/indexeddb` for a larger durable store:"},"510":{"id":"/en/docs/integrations/sync-31","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#storage","content":"There is no silent fallback to memory: a runtime with nowhere durable to write\nis refused, because the outbox surviving a crash is the reason it exists."},"511":{"id":"/en/docs/integrations/sync-32","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#delivery","content":"Mutations are delivered **at least once**. The window between the remote\ncommitting a write and the acknowledgement reaching durable storage cannot be\nclosed from the client, so a crash inside it means the restart sends that\nmutation again. Treat mutation `id` values idempotently."},"512":{"id":"/en/docs/integrations/sync-33","page_id":"/en/docs/integrations/sync","tags":[],"type":"text","url":"/en/docs/integrations/sync#delivery","content":"The package README\ncovers the durable checkpoint format, what each built-in adapter guarantees\nunder replay, and the CRUD baseline."},"513":{"id":"/en/docs/integrations/yjs","page_id":"/en/docs/integrations/yjs","type":"page","content":"Yjs collaboration","breadcrumbs":["Coaction","Integrations"],"tags":[],"url":"/en/docs/integrations/yjs"},"514":{"id":"/en/docs/integrations/yjs-0","page_id":"/en/docs/integrations/yjs","tags":[],"type":"text","url":"/en/docs/integrations/yjs","content":"Bind Coaction-owned pure state to a Y.Doc and let a Yjs provider handle peer transport."},"515":{"id":"/en/docs/integrations/yjs-1","page_id":"/en/docs/integrations/yjs","type":"heading","tags":[],"url":"/en/docs/integrations/yjs#middleware-setup","content":"Middleware setup"},"516":{"id":"/en/docs/integrations/yjs-2","page_id":"/en/docs/integrations/yjs","type":"heading","tags":[],"url":"/en/docs/integrations/yjs#use-an-existing-ydoc","content":"Use an existing Y.Doc"},"517":{"id":"/en/docs/integrations/yjs-3","page_id":"/en/docs/integrations/yjs","type":"heading","tags":[],"url":"/en/docs/integrations/yjs#storage-and-sync-model","content":"Storage and sync model"},"518":{"id":"/en/docs/integrations/yjs-4","page_id":"/en/docs/integrations/yjs","type":"heading","tags":[],"url":"/en/docs/integrations/yjs#conflict-semantics","content":"Conflict semantics"},"519":{"id":"/en/docs/integrations/yjs-5","page_id":"/en/docs/integrations/yjs","type":"heading","tags":[],"url":"/en/docs/integrations/yjs#requirements-and-limits","content":"Requirements and limits"},"520":{"id":"/en/docs/integrations/yjs-6","page_id":"/en/docs/integrations/yjs","tags":[],"type":"text","url":"/en/docs/integrations/yjs","content":"`@coaction/yjs` synchronizes a Coaction store's pure data with Yjs. It does not provide a network\nconnection; choose `y-websocket`, `y-webrtc`, or another Yjs provider for peer transport."},"521":{"id":"/en/docs/integrations/yjs-7","page_id":"/en/docs/integrations/yjs","tags":[],"type":"text","url":"/en/docs/integrations/yjs#middleware-setup","content":"The middleware creates a `Y.Doc`, binds the store, and connects cleanup to `store.destroy()`."},"522":{"id":"/en/docs/integrations/yjs-8","page_id":"/en/docs/integrations/yjs","tags":[],"type":"text","url":"/en/docs/integrations/yjs#use-an-existing-ydoc","content":"`bindYjs()` returns the `doc`, root `map`, `syncNow()`, and `destroy()`."},"523":{"id":"/en/docs/integrations/yjs-9","page_id":"/en/docs/integrations/yjs","tags":[],"type":"text","url":"/en/docs/integrations/yjs#storage-and-sync-model","content":"State lives under `doc.getMap(key).get('state')`."},"524":{"id":"/en/docs/integrations/yjs-10","page_id":"/en/docs/integrations/yjs","tags":[],"type":"text","url":"/en/docs/integrations/yjs#storage-and-sync-model","content":"Nested objects and arrays become nested `Y.Map` and `Y.Array` structures."},"525":{"id":"/en/docs/integrations/yjs-11","page_id":"/en/docs/integrations/yjs","tags":[],"type":"text","url":"/en/docs/integrations/yjs#storage-and-sync-model","content":"Local Coaction changes are diffed against the last synchronized snapshot."},"526":{"id":"/en/docs/integrations/yjs-12","page_id":"/en/docs/integrations/yjs","tags":[],"type":"text","url":"/en/docs/integrations/yjs#storage-and-sync-model","content":"Remote Yjs updates are replayed into Coaction."},"527":{"id":"/en/docs/integrations/yjs-13","page_id":"/en/docs/integrations/yjs","tags":[],"type":"text","url":"/en/docs/integrations/yjs#storage-and-sync-model","content":"Methods and computed getters are not part of the synchronized payload."},"528":{"id":"/en/docs/integrations/yjs-14","page_id":"/en/docs/integrations/yjs","tags":[],"type":"text","url":"/en/docs/integrations/yjs#storage-and-sync-model","content":"The default key is `coaction:${store.name}`."},"529":{"id":"/en/docs/integrations/yjs-15","page_id":"/en/docs/integrations/yjs","tags":[],"type":"text","url":"/en/docs/integrations/yjs#conflict-semantics","content":"Concurrent edits to different fields can merge through Yjs. Conflicts on the same scalar field\nfollow Yjs semantics, effectively last-writer-wins for that value. When an operation must be\ncommutative—such as a distributed counter—model that field with a CRDT-native Yjs structure or\noperation instead of repeatedly replacing a scalar."},"530":{"id":"/en/docs/integrations/yjs-16","page_id":"/en/docs/integrations/yjs","tags":[],"type":"text","url":"/en/docs/integrations/yjs#requirements-and-limits","content":"Keep synchronized state plain and serializable."},"531":{"id":"/en/docs/integrations/yjs-17","page_id":"/en/docs/integrations/yjs","tags":[],"type":"text","url":"/en/docs/integrations/yjs#requirements-and-limits","content":"Yjs binding is supported on local and shared-main stores, not shared clients."},"532":{"id":"/en/docs/integrations/yjs-18","page_id":"/en/docs/integrations/yjs","tags":[],"type":"text","url":"/en/docs/integrations/yjs#requirements-and-limits","content":"Bind the owning store only; a client mirror must not create a second collaboration authority."},"533":{"id":"/en/docs/integrations/yjs-19","page_id":"/en/docs/integrations/yjs","tags":[],"type":"text","url":"/en/docs/integrations/yjs#requirements-and-limits","content":"Very large or highly volatile trees can generate substantial update traffic."},"534":{"id":"/en/docs/integrations/yjs-20","page_id":"/en/docs/integrations/yjs","tags":[],"type":"text","url":"/en/docs/integrations/yjs#requirements-and-limits","content":"Always release old bindings to prevent duplicate observers and stale writes."},"535":{"id":"/en/docs/integrations/yjs-21","page_id":"/en/docs/integrations/yjs","tags":[],"type":"text","url":"/en/docs/integrations/yjs#requirements-and-limits","content":"Remote snapshots and deletes still follow Coaction's fixed schema. Unknown root keys are rejected;\nknown single-store fields may become `undefined` if absent from an exact replacement."},"536":{"id":"/en/docs/shared/json-contract","page_id":"/en/docs/shared/json-contract","type":"page","content":"Shared JSON contract","breadcrumbs":["Coaction","Shared runtime"],"tags":[],"url":"/en/docs/shared/json-contract"},"537":{"id":"/en/docs/shared/json-contract-0","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract","content":"Know exactly which values may cross Coaction's worker, tab, and transport boundary."},"538":{"id":"/en/docs/shared/json-contract-1","page_id":"/en/docs/shared/json-contract","type":"heading","tags":[],"url":"/en/docs/shared/json-contract#supported-values","content":"Supported values"},"539":{"id":"/en/docs/shared/json-contract-2","page_id":"/en/docs/shared/json-contract","type":"heading","tags":[],"url":"/en/docs/shared/json-contract#rejected-values","content":"Rejected values"},"540":{"id":"/en/docs/shared/json-contract-3","page_id":"/en/docs/shared/json-contract","type":"heading","tags":[],"url":"/en/docs/shared/json-contract#methods-and-getters-are-not-data","content":"Methods and getters are not data"},"541":{"id":"/en/docs/shared/json-contract-4","page_id":"/en/docs/shared/json-contract","type":"heading","tags":[],"url":"/en/docs/shared/json-contract#model-common-values-explicitly","content":"Model common values explicitly"},"542":{"id":"/en/docs/shared/json-contract-5","page_id":"/en/docs/shared/json-contract","type":"heading","tags":[],"url":"/en/docs/shared/json-contract#local-mode-is-different","content":"Local mode is different"},"543":{"id":"/en/docs/shared/json-contract-6","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract","content":"Every value crossing shared mode is encoded as JSON. Coaction validates values before they enter\nthe wire protocol rather than relying on `JSON.stringify()` to silently normalize them."},"544":{"id":"/en/docs/shared/json-contract-7","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract","content":"The rule applies to:"},"545":{"id":"/en/docs/shared/json-contract-8","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract","content":"initial shared state and full-sync snapshots;"},"546":{"id":"/en/docs/shared/json-contract-9","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract","content":"action arguments;"},"547":{"id":"/en/docs/shared/json-contract-10","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract","content":"non-void action results;"},"548":{"id":"/en/docs/shared/json-contract-11","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract","content":"patch values;"},"549":{"id":"/en/docs/shared/json-contract-12","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract","content":"replacement state carried by transport operations."},"550":{"id":"/en/docs/shared/json-contract-13","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#supported-values","content":"A transported value must be a tree composed of:"},"551":{"id":"/en/docs/shared/json-contract-14","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#supported-values","content":"`null`;"},"552":{"id":"/en/docs/shared/json-contract-15","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#supported-values","content":"booleans and strings;"},"553":{"id":"/en/docs/shared/json-contract-16","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#supported-values","content":"finite numbers other than negative zero;"},"554":{"id":"/en/docs/shared/json-contract-17","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#supported-values","content":"dense arrays of supported values;"},"555":{"id":"/en/docs/shared/json-contract-18","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#supported-values","content":"plain records with safe string keys and supported values."},"556":{"id":"/en/docs/shared/json-contract-19","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#rejected-values","content":"Coaction rejects values that JSON cannot preserve without semantic loss:"},"557":{"id":"/en/docs/shared/json-contract-20","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#rejected-values","content":"Category"},"558":{"id":"/en/docs/shared/json-contract-21","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#rejected-values","content":"Examples"},"559":{"id":"/en/docs/shared/json-contract-22","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#rejected-values","content":"Missing/non-JSON primitives"},"560":{"id":"/en/docs/shared/json-contract-23","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#rejected-values","content":"`undefined`, `BigInt`, symbols"},"561":{"id":"/en/docs/shared/json-contract-24","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#rejected-values","content":"Non-finite or normalized numbers"},"562":{"id":"/en/docs/shared/json-contract-25","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#rejected-values","content":"`NaN`, `Infinity`, `-Infinity`, `-0`"},"563":{"id":"/en/docs/shared/json-contract-26","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#rejected-values","content":"Runtime behavior in data"},"564":{"id":"/en/docs/shared/json-contract-27","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#rejected-values","content":"functions, accessors"},"565":{"id":"/en/docs/shared/json-contract-28","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#rejected-values","content":"Non-plain platform objects"},"566":{"id":"/en/docs/shared/json-contract-29","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#rejected-values","content":"`Date`, `URL`, `Map`, `Set`, typed arrays, DOM objects"},"567":{"id":"/en/docs/shared/json-contract-30","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#rejected-values","content":"Ambiguous graphs"},"568":{"id":"/en/docs/shared/json-contract-31","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#rejected-values","content":"circular references, repeated references to the same object"},"569":{"id":"/en/docs/shared/json-contract-32","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#rejected-values","content":"Non-dense arrays"},"570":{"id":"/en/docs/shared/json-contract-33","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#rejected-values","content":"sparse arrays or arrays with extra enumerable properties"},"571":{"id":"/en/docs/shared/json-contract-34","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#rejected-values","content":"Unsafe keys/paths"},"572":{"id":"/en/docs/shared/json-contract-35","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#rejected-values","content":"`__proto__`, `prototype`, `constructor` in protected patch paths"},"573":{"id":"/en/docs/shared/json-contract-36","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#rejected-values","content":"Repeated references are rejected even if `JSON.stringify()` would duplicate them. A tree does\nnot preserve object identity, so accepting aliases would make the authority and client graphs\nobservably different."},"574":{"id":"/en/docs/shared/json-contract-37","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#methods-and-getters-are-not-data","content":"Store methods and computed accessors remain runtime behavior. Coaction extracts pure state for\ntransport, then materializes the methods and getters declared by the local source on each side."},"575":{"id":"/en/docs/shared/json-contract-38","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#methods-and-getters-are-not-data","content":"Do not place a function inside a data object and expect it to behave like an action."},"576":{"id":"/en/docs/shared/json-contract-39","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#model-common-values-explicitly","content":"Convert the value at the application boundary and give it a stable domain representation."},"577":{"id":"/en/docs/shared/json-contract-40","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#local-mode-is-different","content":"The strict JSON contract applies only when state crosses a shared boundary. A local store may\nhold richer application values, subject to the normal immutable state model. If a store might\nmove into a worker later, keeping its data JSON-shaped from the beginning makes that migration\npredictable."},"578":{"id":"/en/docs/shared/json-contract-41","page_id":"/en/docs/shared/json-contract","tags":[],"type":"text","url":"/en/docs/shared/json-contract#local-mode-is-different","content":"Shared mode intentionally fails closed. If a value is not a lossless JSON\ntree, model or encode it explicitly instead of bypassing transport validation."},"579":{"id":"/en/docs/shared/overview","page_id":"/en/docs/shared/overview","type":"page","content":"Shared runtime overview","breadcrumbs":["Coaction","Shared runtime"],"tags":[],"url":"/en/docs/shared/overview"},"580":{"id":"/en/docs/shared/overview-0","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview","content":"Use one authority and any number of local mirrors across Workers, SharedWorkers, or custom transports."},"581":{"id":"/en/docs/shared/overview-1","page_id":"/en/docs/shared/overview","type":"heading","tags":[],"url":"/en/docs/shared/overview#move-the-same-source","content":"Move the same source"},"582":{"id":"/en/docs/shared/overview-2","page_id":"/en/docs/shared/overview","type":"heading","tags":[],"url":"/en/docs/shared/overview#what-the-runtime-handles","content":"What the runtime handles"},"583":{"id":"/en/docs/shared/overview-3","page_id":"/en/docs/shared/overview","type":"heading","tags":[],"url":"/en/docs/shared/overview#what-the-application-still-owns","content":"What the application still owns"},"584":{"id":"/en/docs/shared/overview-4","page_id":"/en/docs/shared/overview","type":"heading","tags":[],"url":"/en/docs/shared/overview#middleware-placement","content":"Middleware placement"},"585":{"id":"/en/docs/shared/overview-5","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview","content":"Coaction shared mode keeps a single mutation authority. A Worker, SharedWorker, or custom\ntransport can host the main store; page runtimes hold client mirrors."},"586":{"id":"/en/docs/shared/overview-6","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview","content":"Clients are not peers. They can read local mirrored state, subscribe to it, and call methods that\nexecute on the authority. They cannot create an independent write path with `setState()`."},"587":{"id":"/en/docs/shared/overview-7","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview#move-the-same-source","content":"Keep the state factory in a module shared by the authority and clients:"},"588":{"id":"/en/docs/shared/overview-8","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview#move-the-same-source","content":"Create it in a worker:"},"589":{"id":"/en/docs/shared/overview-9","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview#move-the-same-source","content":"Connect from the page:"},"590":{"id":"/en/docs/shared/overview-10","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview#move-the-same-source","content":"On the page, `increment()` returns a promise:"},"591":{"id":"/en/docs/shared/overview-11","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview#move-the-same-source","content":"TypeScript models this client shape with `StoreWithAsyncFunction`/`Asyncify`: methods become\npromise-returning while data fields remain readable from the local mirror."},"592":{"id":"/en/docs/shared/overview-12","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview#what-the-runtime-handles","content":"action discovery and remote method execution;"},"593":{"id":"/en/docs/shared/overview-13","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview#what-the-runtime-handles","content":"strict JSON encoding and message-shape validation;"},"594":{"id":"/en/docs/shared/overview-14","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview#what-the-runtime-handles","content":"monotonically ordered patch updates within an authority epoch;"},"595":{"id":"/en/docs/shared/overview-15","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview#what-the-runtime-handles","content":"duplicate suppression and gap detection;"},"596":{"id":"/en/docs/shared/overview-16","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview#what-the-runtime-handles","content":"atomic full-snapshot recovery;"},"597":{"id":"/en/docs/shared/overview-17","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview#what-the-runtime-handles","content":"reconnect generation isolation;"},"598":{"id":"/en/docs/shared/overview-18","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview#what-the-runtime-handles","content":"rejection of responses from a superseded authority."},"599":{"id":"/en/docs/shared/overview-19","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview#what-the-application-still-owns","content":"choosing the Worker/SharedWorker lifetime;"},"600":{"id":"/en/docs/shared/overview-20","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview#what-the-application-still-owns","content":"designing idempotent actions or application-level deduplication;"},"601":{"id":"/en/docs/shared/overview-21","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview#what-the-application-still-owns","content":"authorization policy for requests reaching the authority;"},"602":{"id":"/en/docs/shared/overview-22","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview#what-the-application-still-owns","content":"keeping every connected runtime on the same Coaction major;"},"603":{"id":"/en/docs/shared/overview-23","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview#what-the-application-still-owns","content":"ensuring state, arguments, and results obey the JSON contract."},"604":{"id":"/en/docs/shared/overview-24","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview#middleware-placement","content":"Persistence, history, and Yjs belong on the owning main store. They mutate or merge state and\nare rejected on a client mirror. Logger can run on either side, but a client logger observes\nmirror updates and proxied calls rather than hidden authority-side work."},"605":{"id":"/en/docs/shared/overview-25","page_id":"/en/docs/shared/overview","tags":[],"type":"text","url":"/en/docs/shared/overview#middleware-placement","content":"See workers and reconnect for multi-tab setup, epochs, and in-flight\naction behavior."},"606":{"id":"/en/docs/shared/workers-and-reconnect","page_id":"/en/docs/shared/workers-and-reconnect","type":"page","content":"Workers, policies, and reconnect","breadcrumbs":["Coaction","Shared runtime"],"tags":[],"url":"/en/docs/shared/workers-and-reconnect"},"607":{"id":"/en/docs/shared/workers-and-reconnect-0","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect","content":"Configure Worker and SharedWorker clients, restrict authority actions, and handle epoch changes safely."},"608":{"id":"/en/docs/shared/workers-and-reconnect-1","page_id":"/en/docs/shared/workers-and-reconnect","type":"heading","tags":[],"url":"/en/docs/shared/workers-and-reconnect#dedicated-worker","content":"Dedicated Worker"},"609":{"id":"/en/docs/shared/workers-and-reconnect-2","page_id":"/en/docs/shared/workers-and-reconnect","type":"heading","tags":[],"url":"/en/docs/shared/workers-and-reconnect#sharedworker-across-tabs","content":"SharedWorker across tabs"},"610":{"id":"/en/docs/shared/workers-and-reconnect-3","page_id":"/en/docs/shared/workers-and-reconnect","type":"heading","tags":[],"url":"/en/docs/shared/workers-and-reconnect#restrict-the-authority-surface","content":"Restrict the authority surface"},"611":{"id":"/en/docs/shared/workers-and-reconnect-4","page_id":"/en/docs/shared/workers-and-reconnect","type":"heading","tags":[],"url":"/en/docs/shared/workers-and-reconnect#epochs-and-sequence-recovery","content":"Epochs and sequence recovery"},"612":{"id":"/en/docs/shared/workers-and-reconnect-5","page_id":"/en/docs/shared/workers-and-reconnect","type":"heading","tags":[],"url":"/en/docs/shared/workers-and-reconnect#awaiting-action-visibility","content":"Awaiting action visibility"},"613":{"id":"/en/docs/shared/workers-and-reconnect-6","page_id":"/en/docs/shared/workers-and-reconnect","type":"heading","tags":[],"url":"/en/docs/shared/workers-and-reconnect#authority-changes-during-an-action","content":"Authority changes during an action"},"614":{"id":"/en/docs/shared/workers-and-reconnect-7","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#dedicated-worker","content":"A dedicated Worker gives one page its own authority lifetime:"},"615":{"id":"/en/docs/shared/workers-and-reconnect-8","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#dedicated-worker","content":"Destroy the Coaction store when the client no longer owns the connection. Terminate the Worker\naccording to your application's ownership model."},"616":{"id":"/en/docs/shared/workers-and-reconnect-9","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#sharedworker-across-tabs","content":"A reusable module can create a SharedWorker in page runtimes and become the authority inside the\nworker runtime:"},"617":{"id":"/en/docs/shared/workers-and-reconnect-10","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#sharedworker-across-tabs","content":"Each tab gets a client mirror while the SharedWorker owns one state instance. Passing the explicit\n`worker` key with an `undefined` value degrades to a local authority. Its `getState()` actions still\nreturn promises and its state, action arguments, and action results obey the shared JSON contract,\nso awaited call sites remain portable between modes."},"618":{"id":"/en/docs/shared/workers-and-reconnect-11","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#sharedworker-across-tabs","content":"Degraded tabs run independent local state. If every tab must see the same state, treat a missing\nSharedWorker as a hard error instead of relying on the fallback. The degraded store has\n`share === false` and owns its state locally, so its low-level `setState()` and `apply()` methods\nremain available. Always invoke actions through `getState()` and await them before reading their\neffects."},"619":{"id":"/en/docs/shared/workers-and-reconnect-12","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#sharedworker-across-tabs","content":"Coaction cannot catch an exception thrown while your code evaluates `new SharedWorker(...)` before\n`create()` is called. Catch that constructor failure yourself only when local fallback is an\nacceptable product decision. A worker or transport that exists but fails during setup is surfaced\nas an error rather than silently changing the authority model."},"620":{"id":"/en/docs/shared/workers-and-reconnect-13","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#restrict-the-authority-surface","content":"The authority only exposes method paths discovered from its store. `transportPolicy` can narrow\nthat surface further:"},"621":{"id":"/en/docs/shared/workers-and-reconnect-14","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#restrict-the-authority-surface","content":"`allowedActions` is an allowlist of method paths."},"622":{"id":"/en/docs/shared/workers-and-reconnect-15","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#restrict-the-authority-surface","content":"`authorize` receives a decoded JSON execute or full-sync request."},"623":{"id":"/en/docs/shared/workers-and-reconnect-16","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#restrict-the-authority-surface","content":"`mapError` may return a deliberately client-visible message."},"624":{"id":"/en/docs/shared/workers-and-reconnect-17","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#restrict-the-authority-surface","content":"Unexpected action errors are redacted to `Remote action failed`. The original error remains on\nthe authority. Treat policy code as trusted application code and keep it side-effect free where\npossible."},"625":{"id":"/en/docs/shared/workers-and-reconnect-18","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#epochs-and-sequence-recovery","content":"Each authority lifetime owns a unique epoch and a sequence that begins at zero. A client:"},"626":{"id":"/en/docs/shared/workers-and-reconnect-19","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#epochs-and-sequence-recovery","content":"fetches an atomic `{ epoch, sequence, state }` snapshot;"},"627":{"id":"/en/docs/shared/workers-and-reconnect-20","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#epochs-and-sequence-recovery","content":"applies only the next sequence for that epoch;"},"628":{"id":"/en/docs/shared/workers-and-reconnect-21","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#epochs-and-sequence-recovery","content":"ignores duplicate or older updates;"},"629":{"id":"/en/docs/shared/workers-and-reconnect-22","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#epochs-and-sequence-recovery","content":"requests a full snapshot after a sequence gap or epoch change."},"630":{"id":"/en/docs/shared/workers-and-reconnect-23","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#epochs-and-sequence-recovery","content":"Snapshot replacement is atomic. A failed validation or apply step leaves the client's previous\nepoch, sequence, and state intact."},"631":{"id":"/en/docs/shared/workers-and-reconnect-24","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#awaiting-action-visibility","content":"An action response includes the authority epoch and resulting sequence. The client waits for its\nmirror to catch up before resolving the action promise. If the incremental update does not arrive\nwithin `executeSyncTimeoutMs` (default `1500` ms), the client falls back to full sync."},"632":{"id":"/en/docs/shared/workers-and-reconnect-25","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#awaiting-action-visibility","content":"Increase the timeout only when legitimate worker execution and message scheduling routinely\nexceed the default. It is not a replacement for fixing a broken transport."},"633":{"id":"/en/docs/shared/workers-and-reconnect-26","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#authority-changes-during-an-action","content":"If the authority changes while an action is in flight, a response from the old epoch rejects with\n`ActionAuthorityChangedError`."},"634":{"id":"/en/docs/shared/workers-and-reconnect-27","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#authority-changes-during-an-action","content":"Its `outcome` is `unknown`: the old authority may already have performed the action. Retry only\nwhen the action is idempotent or protected by an application-level idempotency key."},"635":{"id":"/en/docs/shared/workers-and-reconnect-28","page_id":"/en/docs/shared/workers-and-reconnect","tags":[],"type":"text","url":"/en/docs/shared/workers-and-reconnect#authority-changes-during-an-action","content":"Reconnect callbacks are generation-scoped, so a late callback from an older connection cannot\noverwrite state established by a newer one."},"636":{"id":"/en/docs/reference/contributing","page_id":"/en/docs/reference/contributing","type":"page","content":"Contributing","breadcrumbs":["Coaction","Reference"],"tags":[],"url":"/en/docs/reference/contributing"},"637":{"id":"/en/docs/reference/contributing-0","page_id":"/en/docs/reference/contributing","tags":[],"type":"text","url":"/en/docs/reference/contributing","content":"Navigate the repository, run the quality gates, and extend adapters without weakening maintained contracts."},"638":{"id":"/en/docs/reference/contributing-1","page_id":"/en/docs/reference/contributing","type":"heading","tags":[],"url":"/en/docs/reference/contributing#repository-map","content":"Repository map"},"639":{"id":"/en/docs/reference/contributing-2","page_id":"/en/docs/reference/contributing","type":"heading","tags":[],"url":"/en/docs/reference/contributing#quality-commands","content":"Quality commands"},"640":{"id":"/en/docs/reference/contributing-3","page_id":"/en/docs/reference/contributing","type":"heading","tags":[],"url":"/en/docs/reference/contributing#add-an-external-adapter","content":"Add an external adapter"},"641":{"id":"/en/docs/reference/contributing-4","page_id":"/en/docs/reference/contributing","type":"heading","tags":[],"url":"/en/docs/reference/contributing#change-shared-behavior-carefully","content":"Change shared behavior carefully"},"642":{"id":"/en/docs/reference/contributing-5","page_id":"/en/docs/reference/contributing","type":"heading","tags":[],"url":"/en/docs/reference/contributing#pull-request-ci","content":"Pull request CI"},"643":{"id":"/en/docs/reference/contributing-6","page_id":"/en/docs/reference/contributing","tags":[],"type":"text","url":"/en/docs/reference/contributing","content":"Read the repository's\nCONTRIBUTING.md,\nCode of Conduct, and\nSecurity Policy before opening a\nchange. Report vulnerabilities through the security process, not a public issue."},"644":{"id":"/en/docs/reference/contributing-7","page_id":"/en/docs/reference/contributing","tags":[],"type":"text","url":"/en/docs/reference/contributing#repository-map","content":"`packages/core`: local/shared creation, state materialization, patch flow, transports, adapter\nhooks, and lifecycle;"},"645":{"id":"/en/docs/reference/contributing-8","page_id":"/en/docs/reference/contributing","tags":[],"type":"text","url":"/en/docs/reference/contributing#repository-map","content":"`packages/coaction-*`: framework wrappers, whole-store adapters, middleware, and Yjs;"},"646":{"id":"/en/docs/reference/contributing-9","page_id":"/en/docs/reference/contributing","tags":[],"type":"text","url":"/en/docs/reference/contributing#repository-map","content":"`examples`: runnable framework, adapter, shared-worker, middleware, and collaboration examples;"},"647":{"id":"/en/docs/reference/contributing-10","page_id":"/en/docs/reference/